# third-party binaries (download with: see README, "Setup")
tools/vampire
tools/*.zip

# compiled Lean artifacts (rebuild with: see README, "Setup")
*.olean
*.ilean

# large, reproducible data (regenerate from megalodon-lean4's sexprinfo export)
data/corpus.sexpr

# run outputs
results/*.jsonl
results/*.log
__pycache__/
*.pyc

# never commit credentials
.env
*_api_key*
tools/duper-env/*
!tools/duper-env/lakefile.toml
!tools/duper-env/lean-toolchain
!tools/duper-env/lake-manifest.json

# generated CeTTa comparison inputs and run observations
.cetta/
cetta-run.json
results/cetta-*/

# raw Megalodon export and third-party binaries (large; see README, "Setup")
data/mglib/
tools/zipperposition/

# LLM spend ledgers (per-run bookkeeping)
results/*ledger*.jsonl

# embedding caches (regenerable, large)
results/emb_*.json
