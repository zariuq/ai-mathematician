; Optional many-sorted Vampire advice, implemented in PeTTa 1.0.6.
; Import after atp.metta and induction.metta. The prepared THF catalogue
; supplies names/types; no source proofs enter this translation.
; Commands are S-expression data with native-string leaves, not source
; fragments. Solver success is advice, never proof acceptance.

(= (ai-math:smt-render $node)
   (let $fragments (ai-math:smt-fragments $node ())
     (str:join "" $fragments)))
; Difference-list emission copies each string only into the final text.
; The token spine is per syntax node, never per character of a string.
(= (ai-math:smt-fragments $node $tail)
   (if (== (get-type $node) String) (cons-atom $node $tail)
     (if (== (get-metatype $node) Expression)
       (let* (($closed (cons-atom ")" $tail))
              ($body (ai-math:smt-fragment-items $node $closed)))
         (cons-atom "(" $body))
       (AiSMT:Request syntax $node))))
(= (ai-math:smt-fragment-items $nodes $tail)
   (if (== $nodes ()) $tail
     (let ($head $rest) (decons-atom $nodes)
       (if (== $rest ()) (ai-math:smt-fragments $head $tail)
         (let $after (ai-math:smt-fragment-items $rest $tail)
           (let $spaced (cons-atom " " $after)
             (ai-math:smt-fragments $head $spaced)))))))
(= (ai-math:smt-text (AiSMT:Problem $commands $ids $skipped $unexpanded))
   (str:concat (str:join "\n" (map-atom $commands $command (ai-math:smt-render $command))) "\n"))
(= (ai-math:smt-sort $type)
   (case $type
     (((SET) "Set") ((PROP) "Bool") ((NAT) "Nat")
      ((AR $a $b)
       (let* (($left (ai-math:smt-sort $a)) ($right (ai-math:smt-sort $b)))
         (if (and (== (get-type $left) String) (== (get-type $right) String))
           (str:join "" ("Fn_" $left "_" $right)) (AiSMT:Request type $type))))
      ($other (AiSMT:Request type $other)))))
(= (ai-math:smt-type-sorts $type)
   (case $type
     (((AR $a $b)
       (unique-atom (union-atom (ai-math:smt-type-sorts $a)
         (union-atom (ai-math:smt-type-sorts $b) ($type)))))
      ($base ()))))
(= (ai-math:smt-use-sort (AiSMT:State $sorts $constants $values $lambdas) $type)
   (case (ai-math:smt-sort $type)
     (((AiSMT:Request $reason $term) (AiSMT:Request $reason $term))
      ($sort (AiSMT:Sorted $sort (AiSMT:State
               (unique-atom (union-atom $sorts (ai-math:smt-type-sorts $type)))
               $constants $values $lambdas))))))
(= (ai-math:smt-use-constant (AiSMT:State $sorts $constants $values $lambdas) $name $as-value)
   (AiSMT:State $sorts (unique-atom (union-atom $constants ($name)))
     (if $as-value (unique-atom (union-atom $values ($name))) $values) $lambdas))
(= (ai-math:smt-arity $type $args)
   (case $type
     (((AR $a $b) (ai-math:smt-arity $b (union-atom $args ($a))))
      ($result (AiSMT:Arity $args $result)))))
(= (ai-math:smt-variable $prefix $number)
   (str:concat $prefix (str:number->string $number)))
(= (ai-math:smt-variables $prefix $types $number)
   (if (== $types ()) ()
     (cons-atom (AiSMT:Typed (ai-math:smt-variable $prefix $number) (car-atom $types))
       (ai-math:smt-variables $prefix (cdr-atom $types) (+ $number 1)))))
(= (ai-math:smt-id $id) (str:symbol->string $id))
(= (ai-math:smt-constant $context $name)
   (case (ai-math:thf-lookup $context Name $name)
     (((AiTHF:Binding $id (AiTHF:Fact $i $kind $n $type $body))
       (if (ai-math:contains (PARAM PRIM DEF) $kind)
         (if (== (get-type (ai-math:smt-sort $type)) String)
           (AiSMT:Constant (ai-math:smt-id $id) $type)
           (AiSMT:Request constant-type ($name $type)))
         (AiSMT:Request constant-kind $name)))
      ($other (AiSMT:Request unresolved-constant $name)))))

; Persistent translation states make speculative premise/definition lowering
; transactional: only a successful, admitted result publishes its new state.
(= (ai-math:smt-terms $context $nodes $env $state)
   (foldl-atom $nodes (AiSMT:Terms () $state) $out $node
     (case $out
       (((AiSMT:Terms $terms $before)
         (case (ai-math:smt-term $context $node $env $before)
           (((AiSMT:Term $term $type $after)
             (AiSMT:Terms (union-atom $terms ((AiSMT:Typed $term $type))) $after))
            ($request $request))))
        ($request $request)))))
(= (ai-math:smt-term $context $node $env $state)
   (case $node
     (((DB $i)
       (if (and (>= $i 0) (< $i (size-atom $env)))
         (let (AiSMT:Var $name $type $bridged)
           (index-atom $env (- (- (size-atom $env) $i) 1))
           (AiSMT:Term (if $bridged ("e" $name) $name) $type $state))
         (AiSMT:Request free-variable $node)))
      ((ALL $type $body) (ai-math:smt-forall $context $type $body $env $state))
      ((IMP $a $b)
       (case (ai-math:smt-terms $context ($a $b) $env $state)
         (((AiSMT:Terms ((AiSMT:Typed $left $lt) (AiSMT:Typed $right $rt)) $after)
           (AiSMT:Term ("=>" $left $right) (PROP) $after))
          ($request $request))))
      ((LAM $type $body) (ai-math:smt-lift $context $type $body $env $state))
      ((AP $f $a) (ai-math:smt-application $context $node $env $state))
      ((TMH $hash) (ai-math:smt-application $context $node $env $state))
      ((PRIM $i) (ai-math:smt-application $context $node $env $state))
      ((TPAP $f $type) (ai-math:smt-application $context $node $env $state))
      ($other (AiSMT:Request term $other)))))
(= (ai-math:smt-forall $context $type $body $env $state)
   (case (ai-math:smt-use-sort $state $type)
     (((AiSMT:Sorted $sort $before)
       (let $name (ai-math:smt-variable "X" (size-atom $env))
         (case (ai-math:smt-term $context $body
                 (union-atom $env ((AiSMT:Var $name $type false))) $before)
           (((AiSMT:Term $term $result $after)
             (AiSMT:Term ("forall" (($name $sort)) $term) (PROP) $after))
            ($request $request)))))
      ($request $request))))
(= (ai-math:smt-env-binders $env)
   (map-atom $env $entry
     (let (AiSMT:Var $name $type $bridged) $entry
       ($name (if $bridged "Nat" (ai-math:smt-sort $type))))))
(= (ai-math:smt-call $name $arguments)
   (if (== $arguments ()) $name (cons-atom $name $arguments)))
(= (ai-math:smt-lift $context $type $body $env $state)
   (let $variable (ai-math:smt-variable "X" (size-atom $env))
     (case (ai-math:smt-term $context $body
             (union-atom $env ((AiSMT:Var $variable $type false))) $state)
       (((AiSMT:Term $term $result $before)
         (case (ai-math:smt-use-sort $before (AR $type $result))
           (((AiSMT:Sorted $sort (AiSMT:State $sorts $constants $values $lambdas))
             (let* (($params (ai-math:smt-env-binders $env))
                    ($key ($sort $params $term))
                    ($old (filter-atom $lambdas $row (== (index-atom $row 1) $key)))
                    ($name (if (== $old ()) (ai-math:smt-variable "lam" (size-atom $lambdas))
                             (index-atom (car-atom $old) 2)))
                    ($call (ai-math:smt-call $name (map-atom $params $p (car-atom $p))))
                    ($decl ("declare-fun" $name (map-atom $params $p (index-atom $p 1)) $sort))
                    ($axiom ("assert" ("forall"
                      (union-atom $params (($variable (ai-math:smt-sort $type))))
                      ("=" ((str:concat "app_" $sort) $call $variable) $term)))))
               (AiSMT:Term $call (AR $type $result)
                 (AiSMT:State $sorts $constants $values
                   (if (== $old ()) (union-atom $lambdas ((AiSMT:Lambda $key $name $decl $axiom))) $lambdas)))))
            ($request $request))))
        ($request $request)))))
(= (ai-math:smt-apply $function $type $arguments $state)
   (if (== $arguments ()) (AiSMT:Term $function $type $state)
     (case $type
       (((AR $a $b)
         (case (ai-math:smt-use-sort $state $type)
           (((AiSMT:Sorted $sort $after)
             (let ($argument $rest) (decons-atom $arguments)
               (let (AiSMT:Typed $term $ty) $argument
                 (ai-math:smt-apply ((str:concat "app_" $sort) $function $term) $b $rest $after))))
            ($request $request))))
        ($other (AiSMT:Request over-application ($function $type $arguments)))))))
(= (ai-math:smt-application $context $node $env $state)
   (let* (((AiApplication $head $args) (ai-math:application $node ()))
          ((AiTHF:Instantiation $base $types) (ai-math:thf-instantiation $head ())))
     (case (ai-math:smt-terms $context $args $env $state)
       (((AiSMT:Terms $terms $after)
         (if (ai-math:contains (TMH PRIM) (car-atom $base))
           (ai-math:smt-applied $context $node $base $types $args $terms $env $after)
           (case (ai-math:smt-term $context $base $env $after)
             (((AiSMT:Term $function $type $before)
               (ai-math:smt-apply $function $type $terms $before))
              ($request $request)))))
        ($request $request)))))
(= (ai-math:smt-applied $context $node $base $types $args $terms $env $state)
   (let* (($name (ai-math:thf-constant-name $context $base))
          ($n (size-atom $terms))
          ($texts (map-atom $terms $term (index-atom $term 1))))
     (case $name
       (("True" (if (== $n 0) (AiSMT:Term "true" (PROP) $state) (AiSMT:Request logical-arity $node)))
        ("False" (if (== $n 0) (AiSMT:Term "false" (PROP) $state) (AiSMT:Request logical-arity $node)))
        ("not" (if (== $n 1) (AiSMT:Term (cons-atom "not" $texts) (PROP) $state)
                 (AiSMT:Request logical-arity $node)))
        ("and" (ai-math:smt-binary "and" $texts $state $node))
        ("or" (ai-math:smt-binary "or" $texts $state $node))
        ("iff" (ai-math:smt-binary "=" $texts $state $node))
        ("eq" (ai-math:smt-equality false $types $texts $state $node))
        ("neq" (ai-math:smt-equality true $types $texts $state $node))
        ("ex" (ai-math:smt-exists $context $types $args $terms $env $state $node))
        ($constant
         (if (== $types ())
           (case (ai-math:smt-constant $context $constant)
             (((AiSMT:Constant $id $type)
               (let* (((AiSMT:Arity $parameters $result) (ai-math:smt-arity $type ()))
                      ($count (size-atom $parameters)))
                 (if (>= $n $count)
                   (ai-math:smt-apply
                     (ai-math:smt-call $id (list:take $count $texts)) $result
                     (list:drop $count $terms) (ai-math:smt-use-constant $state $constant false))
                   (case (ai-math:smt-use-sort
                           (ai-math:smt-use-constant $state $constant true) $type)
                     (((AiSMT:Sorted $sort $after)
                       (ai-math:smt-apply (str:concat $id "__v") $type $terms $after))
                      ($request $request))))))
              ($request $request)))
           (AiSMT:Request polymorphic-constant $node)))))))
(= (ai-math:smt-binary $operator $terms $state $node)
   (if (== (size-atom $terms) 2) (AiSMT:Term (cons-atom $operator $terms) (PROP) $state)
     (AiSMT:Request logical-arity $node)))
(= (ai-math:smt-equality $negated $types $terms $state $node)
   (if (and (== (size-atom $types) 1) (== (size-atom $terms) 2))
     (let $equal (cons-atom "=" $terms)
       (AiSMT:Term (if $negated ("not" $equal) $equal) (PROP) $state))
     (AiSMT:Request logical-arity $node)))
(= (ai-math:smt-exists $context $types $args $terms $env $state $node)
   (if (and (== (size-atom $types) 1) (== (size-atom $terms) 1))
     (let $type (car-atom $types)
       (case (ai-math:smt-use-sort $state $type)
         (((AiSMT:Sorted $sort $before)
           (case (car-atom $args)
             (((LAM $ignored $body)
               (let $variable (ai-math:smt-variable "X" (size-atom $env))
                 (ai-math:smt-exists-body $variable $sort
                   (ai-math:smt-term $context $body
                     (union-atom $env ((AiSMT:Var $variable $type false))) $before))))
              ($predicate
               (let $variable (ai-math:smt-variable "Z" (size-atom $env))
                 (ai-math:smt-exists-body $variable $sort
                   (ai-math:smt-apply (index-atom (car-atom $terms) 1) (AR $type (PROP))
                     ((AiSMT:Typed $variable $type)) $before)))))))
          ($request $request))))
     (AiSMT:Request logical-arity $node)))
(= (ai-math:smt-exists-body $variable $sort $result)
   (case $result
     (((AiSMT:Term $term $type $state)
       (AiSMT:Term ("exists" (($variable $sort)) $term) (PROP) $state))
      ($request $request))))

; A bridge position counts ALL and IMP prefix occurrences, as does the
; source-derived induction splitter. Only the chosen variable's own nat_p
; guard is erased. Other binders and hypotheses remain in written order.
(= (ai-math:smt-prefix $context $node $env $position $bridge $bound $nat-hash $state)
   (case $node
     (((ALL $type $body)
       (let* (($bridged (== $position $bridge))
              ($variable (ai-math:smt-variable "X" (size-atom $env))))
         (if (and $bridged (not (== $type (SET))))
           (AiSMT:Request bridge-variable-type $type)
           (case (ai-math:smt-use-sort $state $type)
             (((AiSMT:Sorted $sort $before)
               (case (ai-math:smt-prefix $context $body
                       (union-atom $env ((AiSMT:Var $variable $type $bridged)))
                       (+ $position 1) $bridge
                       (if $bridged (size-atom $env) $bound) $nat-hash $before)
                 (((AiSMT:Term $term $result $after)
                   (AiSMT:Term ("forall" (($variable (if $bridged "Nat" $sort))) $term) (PROP) $after))
                  ($request $request))))
              ($request $request))))))
      ((IMP $hyp $body)
       (if (case $hyp
             (((AP (TMH $hash) (DB $i))
               (and (== $hash $nat-hash)
                 (== (- (- (size-atom $env) 1) $i) $bound))) ($other false)))
         (ai-math:smt-prefix $context $body $env (+ $position 1) $bridge $bound $nat-hash $state)
         (case (ai-math:smt-term $context $hyp $env $state)
           (((AiSMT:Term $left $type $before)
             (case (ai-math:smt-prefix $context $body $env (+ $position 1) $bridge $bound $nat-hash $before)
               (((AiSMT:Term $right $result $after)
                 (AiSMT:Term ("=>" $left $right) (PROP) $after))
                ($request $request))))
            ($request $request)))))
      ($term (ai-math:smt-term $context $term $env $state)))))
(= (ai-math:smt-motive $statement $variable-position $guard-position $hash)
   (case (ai-math:ind-named $statement SMT AiInd:Root ())
     (((AiInd:Syntax $named)
       (let (AiInd:Prefix $prefix $conclusion) (ai-math:ind-prefix $named ())
         (if (and (>= $variable-position 0) (< $variable-position (size-atom $prefix)))
           (case (index-atom $prefix $variable-position)
             (((AiInd:Binder (SET) $variable)
               (if (== (ai-math:ind-guard $prefix $hash $variable 0) $guard-position)
                 (case (ai-math:ind-db
                         (ai-math:ind-motive $prefix $conclusion $variable $variable-position $guard-position) ())
                   (((AiInd:Syntax (LAM $type $body)) (AiSMT:Motive $body))
                    ($request (AiSMT:Request motive $request))))
                 (AiSMT:Request motive-guard $guard-position)))
              ($other (AiSMT:Request motive-variable $other))))
           (AiSMT:Request motive-position $variable-position))))
      ($request (AiSMT:Request motive $request)))))
(= (ai-math:smt-goal $context $statement $bridge $guard $motive $state)
   (if $motive
     (case (ai-math:smt-motive $statement $bridge $guard (ai-math:smt-nat-hash $context))
       (((AiSMT:Motive $body)
         (case (ai-math:smt-term $context $body ((AiSMT:Var "X0" (SET) true)) $state)
           (((AiSMT:Term $term (PROP) $after)
             (AiSMT:Goal ("forall" (("X0" "Nat")) ("motive" "X0"))
               (("declare-fun" "motive" ("Nat") "Bool")
                ("assert" ("forall" (("X0" "Nat")) ("=" ("motive" "X0") $term)))) $after))
            ((AiSMT:Term $term $type $after) (AiSMT:Request motive-proposition $type))
            ($request $request))))
        ($request $request)))
     (case (if (== $bridge None) (ai-math:smt-term $context $statement () $state)
             (ai-math:smt-prefix $context $statement () 0 $bridge None (ai-math:smt-nat-hash $context) $state))
       (((AiSMT:Term $term (PROP) $after) (AiSMT:Goal $term () $after))
        ((AiSMT:Term $term $type $after) (AiSMT:Request goal-proposition $type))
        ($request $request)))))
(= (ai-math:smt-nat-hash (AiTHF $count $index $formats))
   (ai-math:thf-last
     (collapse (match $index (AiTHF:Entry Hash $hash $ordinal "nat_p") ($ordinal $hash))) AiTHF:Missing))
(= (ai-math:smt-premise $context $cutoff $out $name)
   (let (AiSMT:Premises $commands $ids $skipped $state) $out
     (case (ai-math:thf-lookup $context Name $name)
       (((AiTHF:Binding $id (AiTHF:Fact $i $kind $n $statement $body))
         (if (and (< $i $cutoff) (ai-math:contains (AXIOM THM) $kind))
           (case (ai-math:smt-term $context $statement () $state)
             (((AiSMT:Term $term $type $after)
               (AiSMT:Premises
                 (union-atom $commands (("assert" ("!" $term ":named" (ai-math:smt-id $id)))))
                 (union-atom $ids ((AiTHF:Premise $id $name))) $skipped $after))
              ($request (AiSMT:Premises $commands $ids
                (union-atom $skipped ((AiSMT:Skipped $name $request))) $state))))
           (AiSMT:Premises $commands $ids $skipped $state)))
        ($other (AiSMT:Premises $commands $ids $skipped $state))))))
(= (ai-math:smt-definition-body $body $parameters $env)
   (if (== $parameters ()) (AiSMT:DefinitionBody $body $env ())
     (case $body
       (((LAM $type $rest)
         (ai-math:smt-definition-body $rest (cdr-atom $parameters)
           (union-atom $env ((AiSMT:Var (ai-math:smt-variable "X" (size-atom $env)) (car-atom $parameters) false)))))
        ($term (AiSMT:DefinitionBody $term $env $parameters))))))
(= (ai-math:smt-definition $context $name $type $body $state)
   (let* (((AiSMT:Arity $parameters $result) (ai-math:smt-arity $type ()))
          ((AiSMT:DefinitionBody $term $env $remaining)
            (ai-math:smt-definition-body $body $parameters ())))
     (case (ai-math:smt-term $context $term $env $state)
       (((AiSMT:Term $value $vt $before)
         (let* (($extra (ai-math:smt-variables "X" $remaining (size-atom $env)))
                ($binders (union-atom (ai-math:smt-env-binders $env)
                  (map-atom $extra $v ((index-atom $v 1) (ai-math:smt-sort (index-atom $v 2)))))))
           (case (ai-math:smt-apply $value $vt $extra $before)
             (((AiSMT:Term $rhs $rt $after)
               (let (AiSMT:Constant $id $ct) (ai-math:smt-constant $context $name)
                 (let $equation ("=" (ai-math:smt-call $id (map-atom $binders $v (car-atom $v))) $rhs)
                   (AiSMT:Definition
                     ("assert" (if (== $binders ()) $equation ("forall" $binders $equation)))
                     (ai-math:smt-use-constant $after $name false)))))
              ($request $request)))))
        ($request $request)))))
(= (ai-math:smt-definition-admitted $name $type $command $before $after)
   (let* (((AiSMT:State $bs $bc $bv $bl) $before)
          ((AiSMT:State $as $ac $av $al) $after)
          ((AiSMT:Arity $args $result) (ai-math:smt-arity $type ())))
     (and (not (== $name "nat_p"))
       (and (== $result (PROP))
         (and (== (size-atom $bl) (size-atom $al))
           (and (== (size-atom $bv) (size-atom $av))
             (not (== (get-type (str:find (ai-math:smt-render $command) "Fn_")) Number))))))))
(= (ai-math:smt-expand-definition $context $cutoff $out $name)
   (let (AiSMT:Definitions $commands $skipped $state) $out
     (case (ai-math:thf-lookup $context Name $name)
       (((AiTHF:Binding $id (AiTHF:Fact $i DEF $n $type $body))
         (if (< $i $cutoff)
           (case (ai-math:smt-definition $context $name $type $body $state)
             (((AiSMT:Definition $command $after)
               (if (ai-math:smt-definition-admitted $name $type $command $state $after)
                 (AiSMT:Definitions (union-atom $commands ($command)) $skipped $after)
                 (AiSMT:Definitions $commands $skipped $state)))
              ($request (AiSMT:Definitions $commands
                (union-atom $skipped ((AiSMT:Skipped $name $request))) $state))))
           (AiSMT:Definitions $commands $skipped $state)))
        ($other (AiSMT:Definitions $commands $skipped $state))))))
(= (ai-math:smt-definitions $context $cutoff $frontier $seen $depth $limit $out)
   (if (== $frontier ()) (AiSMT:Closure $out ())
     (if (if (== $limit All) false (> $depth $limit)) (AiSMT:Closure $out $frontier)
       (let* (($after (foldl-atom (sort-atom $frontier) $out $state $name
                       (ai-math:smt-expand-definition $context $cutoff $state $name)))
              ((AiSMT:Definitions $commands $skipped (AiSMT:State $sorts $constants $values $lambdas)) $after)
              ($visited (unique-atom (union-atom $seen $frontier))))
         (ai-math:smt-definitions $context $cutoff (subtraction-atom $constants $visited)
           $visited (+ $depth 1) $limit $after)))))

; Declaration order is deterministic. Sort length orders dependencies before
; their users; source names order constant declarations, as in the reference.
(= (ai-math:smt-sort-order $types)
   (list:sort-by ai-math:smt-sort-before $types))
(= (ai-math:smt-sort-before $left $right)
   (let* (($a (ai-math:smt-sort $left)) ($b (ai-math:smt-sort $right))
          ($al (str:byte-length $a)) ($bl (str:byte-length $b)))
     (if (== $al $bl) (< (str:compare $a $b) 0) (< $al $bl))))
(= (ai-math:smt-constant-declaration $context $name $as-value)
   (let* (((AiSMT:Constant $id $type) (ai-math:smt-constant $context $name))
          ((AiSMT:Arity $parameters $result) (ai-math:smt-arity $type ()))
          ($declaration ("declare-fun" $id (map-atom $parameters $t (ai-math:smt-sort $t)) (ai-math:smt-sort $result))))
     (if $as-value
       (let* (($variables (ai-math:smt-variables "Y" $parameters 0))
              ((AiSMT:Term $lhs $rt $ignored)
                (ai-math:smt-apply (str:concat $id "__v") $type $variables (AiSMT:State () () () ())))
              ($binders (map-atom $variables $v ((index-atom $v 1) (ai-math:smt-sort (index-atom $v 2)))))
              ($rhs (ai-math:smt-call $id (map-atom $variables $v (index-atom $v 1)))))
         ($declaration ("declare-fun" (str:concat $id "__v") () (ai-math:smt-sort $type))
           ("assert" ("forall" $binders ("=" $lhs $rhs)))))
       ($declaration))))
(= (ai-math:smt-declaration-sorts $context $state $name)
   (let* (((AiSMT:Constant $id $type) (ai-math:smt-constant $context $name))
          ((AiSMT:Arity $parameters $result) (ai-math:smt-arity $type ())))
     (foldl-atom (union-atom $parameters ($result)) $state $before $t
       (case (ai-math:smt-use-sort $before $t)
         (((AiSMT:Sorted $sort $after) $after) ($request $request))))))
(= (ai-math:smt-bridge-commands $context)
   (let* (((AiSMT:Constant $empty $et) (ai-math:smt-constant $context "Empty"))
          ((AiSMT:Constant $succ $st) (ai-math:smt-constant $context "ordsucc"))
          ((AiSMT:Constant $nat $nt) (ai-math:smt-constant $context "nat_p")))
     (("assert" ("=" ("e" "zero") $empty))
      ("assert" ("forall" (("n" "Nat")) ("=" ("e" ("succ" "n")) ($succ ("e" "n")))))
      ("assert" ("forall" (("n" "Nat")) ($nat ("e" "n"))))
      ("assert" ("forall" (("x" "Set"))
        ("=>" ($nat "x") ("exists" (("n" "Nat")) ("=" "x" ("e" "n")))))))))
(= (ai-math:smt-finish $context $term $motive $axioms $definitions $ids $skipped $unexpanded $state)
   (let* (($bridge-state (foldl-atom ("Empty" "ordsucc" "nat_p") $state $before $name
                          (ai-math:smt-use-constant $before $name false)))
          ($prepared (foldl-atom (index-atom $bridge-state 2) $bridge-state $before $name
                       (ai-math:smt-declaration-sorts $context $before $name)))
          ((AiSMT:State $sorts $constants $values $lambdas) $prepared)
          ($ordered (ai-math:smt-sort-order $sorts))
          ($sort-decls (map-atom $ordered $t ("declare-sort" (ai-math:smt-sort $t) "0")))
          ($applications (map-atom $ordered $t
                           (let (AR $a $b) $t
                             (let $sort (ai-math:smt-sort $t)
                               ("declare-fun" (str:concat "app_" $sort)
                                 ($sort (ai-math:smt-sort $a)) (ai-math:smt-sort $b))))))
          ($constant-decls (foldl-atom (sort-atom $constants) () $out $name
                             (union-atom $out (ai-math:smt-constant-declaration $context $name
                               (ai-math:contains $values $name)))))
          ($commands (union-atom
            (("set-logic" "ALL") ("declare-sort" "Set" "0"))
            (union-atom $sort-decls (union-atom $applications
              (union-atom
                (("declare-datatypes" (("Nat" "0")) ((("zero") ("succ" ("pred" "Nat")))) )
                 ("declare-fun" "e" ("Nat") "Set"))
                (union-atom $constant-decls
                  (union-atom (map-atom $lambdas $l (index-atom $l 3))
                    (union-atom (map-atom $lambdas $l (index-atom $l 4))
                      (union-atom (ai-math:smt-bridge-commands $context)
                        (union-atom $motive (union-atom $definitions
                          (union-atom $axioms (("assert" ("not" $term)) ("check-sat")))))))))))))))
     (AiSMT:Problem $commands $ids $skipped $unexpanded)))

; The default unfolding depth is the reference bridge's policy, not a parser
; or language limit. Callers may use All. A goal can be an original theorem
; or an induction case carrying the original source cutoff.
(= (ai-math:smt-options-valid $options)
   (if (== (get-metatype $options) Expression)
     (let $valid
       (foldl-atom $options true $ok $entry
         (and $ok (case $entry
           (((bridge $value) (or (== $value None) (ai-math:natural $value)))
            ((guard $value) (or (== $value None) (ai-math:natural $value)))
            ((motive $value) (or (== $value true) (== $value false)))
            ((definition-depth $value) (or (== $value All) (ai-math:natural $value)))
            ($other false)))))
       (if $valid
         (if (ai-math:option $options motive false)
           (and (ai-math:natural (ai-math:option $options bridge None))
             (ai-math:natural (ai-math:option $options guard None))) true) false)) false))
(= (ai-math:smt-bridge-position $statement $position $wanted)
   (if (== $wanted None) true
     (case $statement
       (((ALL $type $body)
         (if (== $position $wanted) (== $type (SET))
           (ai-math:smt-bridge-position $body (+ $position 1) $wanted)))
        ((IMP $hyp $body) (ai-math:smt-bridge-position $body (+ $position 1) $wanted))
        ($other false)))))
(= (ai-math:smt-problem $context $goal $premises $options)
   (if (ai-math:smt-options-valid $options)
     (case $goal
       (((AiTHF:Fact $cutoff $kind $name $statement $body)
         (if (ai-math:smt-bridge-position $statement 0 (ai-math:option $options bridge None))
           (ai-math:smt-build-problem $context $goal $premises $options)
           (AiSMT:Request bridge-position (ai-math:option $options bridge None))))
        ($other (AiSMT:Request goal $other))))
     (AiSMT:Request options $options)))
(= (ai-math:smt-build-problem $context $goal $premises $options)
   (let* (($bridge (ai-math:option $options bridge None))
          ($guard (ai-math:option $options guard None))
          ($motive (ai-math:option $options motive false))
          ($depth (ai-math:option $options definition-depth 3))
          ($base (map-atom (("Empty" (SET)) ("ordsucc" (AR (SET) (SET))) ("nat_p" (AR (SET) (PROP))))
                   $row (let ($name $type) $row
                     (case (ai-math:smt-constant $context $name)
                       (((AiSMT:Constant $id $actual)
                         (if (== $actual $type) (AiSMT:Constant $id $type)
                           (AiSMT:Request bridge-constant-type ($name $actual $type))))
                        ($request $request)))))))
     (if (foldl-atom $base true $ok $c
           (and $ok (case $c (((AiSMT:Constant $id $t) true) ($request false)))))
       (case $goal
         (((AiTHF:Fact $cutoff $kind $name $statement $body)
           (case (ai-math:smt-goal $context $statement $bridge $guard $motive (AiSMT:State () () () ()))
             (((AiSMT:Goal $term $motive-commands $goal-state)
               (let* (((AiSMT:Premises $axioms $ids $skipped $premise-state)
                         (foldl-atom $premises (AiSMT:Premises () () () $goal-state) $out $n
                           (ai-math:smt-premise $context $cutoff $out $n)))
                      ((AiSMT:Closure (AiSMT:Definitions $definitions $all-skipped $state) $unexpanded)
                         (ai-math:smt-definitions $context $cutoff (index-atom $premise-state 2) () 0 $depth
                           (AiSMT:Definitions () $skipped $premise-state))))
                 (ai-math:smt-finish $context $term $motive-commands $axioms $definitions $ids $all-skipped $unexpanded $state)))
              ($request $request))))
          ($other (AiSMT:Request goal $other))))
       (AiSMT:Request bridge-library $base))))
(= (ai-math:smt-vampire $context $problem $executable $seconds $extra)
   (case $problem
     (((AiSMT:Problem $commands $ids $skipped $unexpanded)
       (ai-math:vampire-observation $context (AiTHF:Problem () $ids $skipped $unexpanded)
         (proc:run
           (union-atom ($executable "--input_syntax" "smtlib2" "-t" (str:number->string $seconds))
             (union-atom $extra ("--output_axiom_names" "on" "--proof" "tptp")))
           ((lifetime owner) (stdin (ai-math:smt-text $problem))
            (timeout-ms (if (== $seconds 0) 0 (+ (* $seconds 1000) 15000)))))))
      ($request $request))))
(= (ai-math:smt-summary $report)
   (case (ai-math:atp-summary $report)
     (((AiATP:Advice "Unsatisfiable" $premises $definitions)
       (AiATP:Advice "Theorem" $premises $definitions))
      ($other $other))))
