; cetta --no-results --lang petta phase1/prover_main.metta corpus.sexpr goal [vampire] [lean]
!(import! &self proc)
!(import! &self "library.metta")
!(import! &self (library list))
!(import! &self (library lib_tptp))
!(import! &self re)
!(import! &self "vampire_output.metta")
!(import! &self "search.metta")
!(import! &self "atp.metta")
!(import! &self json)
!(import! &self system)
!(import! &self "itp.metta")
!(import! &self "proof_strategy.metta")
!(import! &self "induction.metta")
!(import! &self "smt_bridge.metta")
!(import! &self "induction_prover.metta")
!(import! &self "prover.metta")

(= (ai-prover-main:text $argument)
   (if (== (get-metatype $argument) Symbol) (str:symbol->string $argument) $argument))
(= (ai-prover-main:exit-code $result)
   (case $result
     (((AiProver:Result $name $i $hints $attempts (AiProver:Proved $s $o $l $t $u $a)) 0)
      ((AiProver:Result $name $i $hints $attempts (AiProver:NotProved $coverage)) 1)
      ((AiProver:Result $name $i $hints $attempts (AiProver:Unfinished $evidence)) 3)
      ($other 2))))

!(if (< (system:argc) 2)
   (let $printed (println! "usage: prover_main.metta corpus.sexpr goal [vampire] [lean]")
     (system:exit 2))
   (let* (($path (ai-prover-main:text (system:arg 0)))
          ($name (ai-prover-main:text (system:arg 1)))
          ($vampire (ai-prover-main:text (if (> (system:argc) 2) (system:arg 2)
                      (system:getenv-or-default "VAMPIRE_BIN" "vampire"))))
          ($lean (ai-prover-main:text (if (> (system:argc) 3) (system:arg 3)
                   (system:getenv-or-default "LEAN_BIN" "lean"))))
          ($root (fs:canonical-path (str:concat (system:entry-directory) "/..")))
          ($context (ai-math:prover (ai-math:load-library $path) $path $root $lean $vampire))
          ($result (ai-math:prove $context $name)))
     (let $printed (println! $result)
       (system:exit (ai-prover-main:exit-code $result)))))
