; Call reservations are written before a request is sent. The caller holds
; an operating-system file lock for this whole operation. Usage rows do not
; refund reservations. A malformed ledger fails closed.

(= (ai-math:llm-ledger-object $row)
   (case $row
     (((JsonObject $pairs)
       (let $keys (ai-math:itp-json-keys $pairs)
         (== (size-atom $keys) (size-atom (unique-atom $keys))))) ($other false))))
(= (ai-math:llm-ledger-line $state $reservations $line)
   (case $state
     (((AiLLM:Calls $count)
       (if (== (str:trim $line) "") $state
         (let $row (json:parse $line)
           (if (and (ai-math:llm-ledger-object $row)
                    (== (json:get $row "schema") "ai-math.llm-ledger.v1"))
             (case ((json:get $row "event") (json:get $row "n") (json:get $row "model"))
               ((("call" $n $model)
                 (if (== $n (+ $count 1))
                   (let $stored (ai-math:put $reservations (+ $count 1) $model) (AiLLM:Calls (+ $count 1)))
                   (AiLLM:LedgerFault nonsequential-reservation)))
                (("usage" $n $model)
                 (let $id $n
                   (if (and (== (ai-math:get $reservations $id AiMissing) $model)
                            (== (ai-math:get $reservations (Usage $id) false) false))
                     (let $marked (ai-math:put $reservations (Usage $id) true) $state)
                     (AiLLM:LedgerFault unknown-or-repeated-usage))))
                ($other (AiLLM:LedgerFault invalid-event))))
             (AiLLM:LedgerFault malformed-ledger)))))
      ($other $state))))
(= (ai-math:llm-ledger-state $path)
   (let $rows (if (fs:exists $path) (fs:read-lines $path) ())
     (case $rows
       (((Error $reason $where) (AiLLM:LedgerFault read-failure))
        ($lines (let $reservations (new-space)
          (case (foldl-atom $lines (AiLLM:Calls 0) $state $line
                  (ai-math:llm-ledger-line $state $reservations $line))
            (((AiLLM:Calls $count) (AiLLM:LedgerState $count $reservations)) ($other $other)))))))))
(= (ai-math:llm-ledger-reserve $path $model $cap)
   (if (and (ai-math:itp-natural $cap) (== (get-type $model) String))
     (case (ai-math:llm-ledger-state $path)
       (((AiLLM:LedgerState $count $reservations)
         (if (>= $count $cap) (AiLLM:Limit $count $cap)
           (let* (($next (+ $count 1))
                  ($row (JsonObject
                    ((JsonPair "schema" "ai-math.llm-ledger.v1")
                     (JsonPair "event" "call")
                     (JsonPair "n" $next)
                     (JsonPair "model" $model)
                     (JsonPair "monotonic-ns" (system:monotonic-ns)))))
                  ($written (fs:append-text $path (str:concat (json:stringify $row) "\n"))))
             (if (== $written ()) (AiLLM:Reserved $next) (AiLLM:LedgerFault append-failure)))))
        ($other $other))) (AiLLM:LedgerFault invalid-reservation)))
(= (ai-math:llm-ledger-usage $path $n $model $usage $elapsed)
   (case (ai-math:llm-ledger-state $path)
     (((AiLLM:LedgerState $count $reservations)
       (if (and (ai-math:itp-natural $n)
                (and (ai-math:itp-natural $elapsed)
                  (and (== (ai-math:get $reservations $n AiMissing) $model)
                       (== (ai-math:get $reservations (Usage $n) false) false))))
         (let $written (fs:append-text $path (str:concat (json:stringify
           (JsonObject ((JsonPair "schema" "ai-math.llm-ledger.v1")
             (JsonPair "event" "usage")
             (JsonPair "n" $n)
             (JsonPair "model" $model) (JsonPair "usage" $usage)
             (JsonPair "nanoseconds" $elapsed)))) "\n"))
           (if (== $written ()) AiLLM:UsageRecorded (AiLLM:LedgerFault append-failure)))
         (AiLLM:LedgerFault invalid-usage-reservation)))
      ($other $other))))
(= (ai-math:llm-ledger-reply $result)
   (case $result
     (((AiLLM:Reserved $n)
       (JsonObject ((JsonPair "kind" "reserved") (JsonPair "n" $n))))
      (AiLLM:UsageRecorded (JsonObject ((JsonPair "kind" "usage-recorded"))))
      ((AiLLM:Limit $n $cap) (JsonObject ((JsonPair "kind" "limit")
        (JsonPair "n" $n) (JsonPair "cap" $cap))))
      ((AiLLM:Usage $calls $prompt $completion)
       (JsonObject ((JsonPair "kind" "usage-summary") (JsonPair "calls" $calls)
         (JsonPair "prompt_tokens" $prompt) (JsonPair "completion_tokens" $completion))))
      ($other (JsonObject ((JsonPair "kind" "ledger-fault")))))))
(= (ai-math:llm-usage-count $row $key)
   (let $value (json:get (json:get $row "usage") $key)
     (if (ai-math:itp-natural $value) $value 0)))
(= (ai-math:llm-ledger-summary $path)
   (case (ai-math:llm-ledger-state $path)
     (((AiLLM:LedgerState $calls $reservations)
       (foldl-atom (if (fs:exists $path) (fs:read-lines $path) ())
         (AiLLM:Usage $calls 0 0) $state $line
         (let (AiLLM:Usage $n $prompt $completion) $state
           (let $row (json:parse $line)
             (if (== (json:get $row "event") "usage")
               (AiLLM:Usage $n (+ $prompt (ai-math:llm-usage-count $row "prompt_tokens"))
                 (+ $completion (ai-math:llm-usage-count $row "completion_tokens"))) $state)))))
      ($other $other))))
(= (ai-math:llm-ledger-request $path $request)
   (if (ai-math:llm-ledger-object $request)
     (case (json:get $request "operation")
       (("reserve"
         (case ((json:get $request "model") (json:get $request "cap"))
           ((($model $cap)
             (ai-math:llm-ledger-reserve $path $model $cap))
            ($other (AiLLM:LedgerFault invalid-request)))))
        ("usage"
         (case ((json:get $request "model") (json:get $request "n") (json:get $request "nanoseconds"))
           ((($model $n $elapsed)
             (ai-math:llm-ledger-usage $path $n $model (json:get $request "usage")
               $elapsed))
            ($other (AiLLM:LedgerFault invalid-request)))))
        ("summary" (ai-math:llm-ledger-summary $path))
        ($other (AiLLM:LedgerFault invalid-request)))) (AiLLM:LedgerFault invalid-request)))
