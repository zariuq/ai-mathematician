; Structural typed-export -> Lean source translation, on PeTTa 1.0.6.
; Import library.metta and list at the entry point. No tactic or axiom is
; invented for a missing proof. Only source PARAM/PRIM/AXIOM declarations
; become Lean axioms; every source PROOF becomes an ordinary theorem term.

(= (ai-math:lean-context) (AiLean (new-space) (new-space) (new-space)))
(= (ai-math:lean-fresh (AiLean $index $counter $deps) $base)
   (let* (($next (+ (ai-math:get $counter Counter 0) 1))
          ($changed (ai-math:put $counter Counter $next)))
     (str:concat $base (str:number->string $next))))
(= (ai-math:lean-natural $value)
   (if (== (get-type $value) Number)
     (and (>= $value 0) (== $value (floor-math $value))) false))
(= (ai-math:lean-safe-name $name)
   (if (== (get-type $name) String)
     (and (> (str:byte-length $name) 0)
       (foldl-atom (str:codepoints $name) true $ok $cp
         (and $ok (not (ai-math:contains ("»" "\n" "\r" "\t" "\u0000") $cp))))) false))
(= (ai-math:lean-identifier $name) (str:join "" ("«" $name "»")))
(= (ai-math:lean-global (AiLean $index $counter $deps) $key)
   (case (ai-math:get $index $key AiLean:Missing)
     ((AiLean:Missing (AiLean:Request unresolved-reference $key))
      ((AiLean:Name $name)
       (let $stored (ai-math:put $deps $name true)
         (AiLean:Text (str:concat "Megalodon." (ai-math:lean-identifier $name))))))))
(= (ai-math:lean-bound $names $index $term)
   (if (and (ai-math:lean-natural $index) (< $index (size-atom $names)))
     (AiLean:Text (index-atom $names $index)) (AiLean:Request unbound-variable $term)))
(= (ai-math:lean-concat $parts)
   (let $bad (filter-atom $parts $part
          (case $part (((AiLean:Text $text) false) ($other true))))
     (if (== $bad ())
       (AiLean:Text (str:join "" (map-atom $parts $part (index-atom $part 1)))) (car-atom $bad))))
(= (ai-math:lean-binary $context $scope $kind $left $right $separator)
   (ai-math:lean-concat ((AiLean:Text "(") (ai-math:lean-term $context $scope $kind $left)
     (AiLean:Text $separator) (ai-math:lean-term $context $scope $kind $right) (AiLean:Text ")"))))
(= (ai-math:lean-binder $context (AiLean:Scope $types $terms $proofs) $kind $type $body $base $keyword $separator)
   (let* (($name (ai-math:lean-fresh $context $base))
          ($ty (ai-math:lean-term $context (AiLean:Scope $types $terms $proofs)
                 (if (== $base "h") Tm Tp) $type))
          ($inner (if (== $base "h") (AiLean:Scope $types $terms (cons-atom $name $proofs))
                    (AiLean:Scope $types (cons-atom $name $terms) $proofs))))
     (ai-math:lean-concat ((AiLean:Text $keyword) (AiLean:Text $name) (AiLean:Text " : ") $ty
       (AiLean:Text $separator) (ai-math:lean-term $context $inner $kind $body) (AiLean:Text ")")))))
(= (ai-math:lean-term $context $scope $kind $term)
   (let (AiLean:Scope $types $terms $proofs) $scope
     (case ($kind $term)
       (((Tp (SET)) (AiLean:Text "Megalodon.set"))
        ((Tp (PROP)) (AiLean:Text "Prop"))
        ((Tp (TPVAR $i)) (ai-math:lean-bound $types $i $term))
        ((Tp (AR $a $b)) (ai-math:lean-binary $context $scope Tp $a $b " -> "))
        ((Tm (DB $i)) (ai-math:lean-bound $terms $i $term))
        ((Tm (TMH $h)) (ai-math:lean-global $context (Hash $h)))
        ((Tm (PRIM $i)) (ai-math:lean-global $context (Primitive $i)))
        ((Tm (AP $f $a)) (ai-math:lean-binary $context $scope Tm $f $a " "))
        ((Tm (IMP $a $b)) (ai-math:lean-binary $context $scope Tm $a $b " -> "))
        ((Tm (ALL $ty $body)) (ai-math:lean-binder $context $scope Tm $ty $body "x" "(forall " ", "))
        ((Tm (LAM $ty $body)) (ai-math:lean-binder $context $scope Tm $ty $body "x" "(fun " " => "))
        ((Tm (TPAP $f $ty)) (ai-math:lean-concat ((AiLean:Text "(")
          (ai-math:lean-term $context $scope Tm $f) (AiLean:Text " ")
          (ai-math:lean-term $context $scope Tp $ty) (AiLean:Text ")"))))
        ((Pf (HYP $i)) (ai-math:lean-bound $proofs $i $term))
        ((Pf (KNOWN $h)) (ai-math:lean-global $context (Hash $h)))
        ((Pf (PPFAP $f $a)) (ai-math:lean-binary $context $scope Pf $f $a " "))
        ((Pf (PTMAP $f $a)) (ai-math:lean-concat ((AiLean:Text "(")
          (ai-math:lean-term $context $scope Pf $f) (AiLean:Text " ")
          (ai-math:lean-term $context $scope Tm $a) (AiLean:Text ")"))))
        ((Pf (PTPAP $f $ty)) (ai-math:lean-concat ((AiLean:Text "(")
          (ai-math:lean-term $context $scope Pf $f) (AiLean:Text " ")
          (ai-math:lean-term $context $scope Tp $ty) (AiLean:Text ")"))))
        ((Pf (TLAM $ty $body)) (ai-math:lean-binder $context $scope Pf $ty $body "x" "(fun " " => "))
        ((Pf (PLAM $ty $body)) (ai-math:lean-binder $context $scope Pf $ty $body "h" "(fun " " => "))
        ((Pf (PTPLAM $body))
         (let $name (ai-math:lean-fresh $context "T")
           (ai-math:lean-concat ((AiLean:Text (str:join "" ("(fun " $name " : Type => ")))
             (ai-math:lean-term $context (AiLean:Scope (cons-atom $name $types) $terms $proofs) Pf $body)
             (AiLean:Text ")")))))
        ($other (AiLean:Request unsupported-term ($kind $term)))))))

(= (ai-math:lean-type-parameters $context $arity)
   (if (== $arity 0) ()
     (let $name (ai-math:lean-fresh $context "T")
       (cons-atom $name (ai-math:lean-type-parameters $context (- $arity 1))))))
(= (ai-math:lean-parameters-text $names)
   (str:join "" (map-atom $names $name (str:join "" ("(" $name " : Type) ")))))
(= (ai-math:lean-claim (AiLean $index $counter $deps) $hash $type)
   (let $old (ai-math:get $index (Claim $hash) AiLean:Missing)
     (if (or (== $old AiLean:Missing) (== $old $type))
       (let $stored (ai-math:put $index (Claim $hash) $type) AiLean:Consistent)
       (AiLean:Request inconsistent-statement-hash $hash))))
(= (ai-math:lean-entry (AiLean $index $counter $deps) $kind $name $hash $parameters $type $body)
   (case (ai-math:lean-concat ($type $body))
     (((AiLean:Text $checked)
       (let* (($named (ai-math:put $index (Hash $hash) (AiLean:Name $name)))
              ($entry-name (ai-math:put $index (Name $name) true))
              ($dependencies (sort-atom (collapse (match $deps (AiEntry $key true) $key)))))
         (AiLean:Entry $kind $name
           (str:join "" ((case $kind ((DEF "noncomputable def ") (THM "theorem ") ($other "axiom ")))
             (ai-math:lean-identifier $name) " " (ai-math:lean-parameters-text $parameters)
             ": " (index-atom $type 1) (if (ai-math:contains (DEF THM) $kind)
               (str:concat " := " (index-atom $body 1)) ""))) $dependencies)))
      ($request $request))))
(= (ai-math:lean-declaration $context $form)
   (let (AiLean $index $counter $ignored-deps) $context
     (let $local (AiLean $index $counter (new-space))
       (case $form
         (((PARAM $name $hash $arity $type) (ai-math:lean-declare $local PARAM $name $hash $arity $type NoBody))
          ((AXIOM $name $hash $arity $type) (ai-math:lean-declare $local AXIOM $name $hash $arity $type NoBody))
          ((DEF $name $hash $arity $type $body) (ai-math:lean-declare $local DEF $name $hash $arity $type $body))
          ((PRIM $id $name $hash $type)
           (case (ai-math:lean-declare $local PRIM $name $hash 0 $type NoBody)
             (((AiLean:Entry $kind $n $text $deps)
               (let $stored (ai-math:put $index (Primitive $id) (AiLean:Name $name))
                 (AiLean:Entry $kind $n $text $deps))) ($other $other))))
          ((THM $name $hash $proof-hash $arity $type) (ai-math:lean-declare $local THM $name $hash $arity $type NoBody))
          ((PROOF $name $body)
           (case (ai-math:get $index (Pending $name) AiLean:Missing)
             ((AiLean:Missing (AiLean:Request orphan-proof $name))
              ((AiLean:Pending $hash $parameters $type $deps)
               (let* (($loaded (map-atom $deps $dep (ai-math:put (index-atom $local 3) $dep true)))
                      ($proof (ai-math:lean-term $local (AiLean:Scope (list:reverse $parameters) () ()) Pf $body))
                      ($entry (ai-math:lean-entry $local THM $name $hash $parameters $type $proof)))
                 (case $entry
                   (((AiLean:Entry $k $n $text $ds)
                     (let $removed (ai-math:remove $index (Pending $name)) (AiLean:Entry $k $n $text $ds)))
                    ($other $other))))))))
          ($other (AiLean:Request unsupported-declaration $form)))))))
(= (ai-math:lean-declare $context $kind $name $hash $arity $type $body)
   (let (AiLean $index $counter $deps) $context
     (if (and (ai-math:lean-safe-name $name) (and (== (get-type $hash) String) (ai-math:lean-natural $arity)))
       (if (and (== (ai-math:get $index (Name $name) AiLean:Missing) AiLean:Missing)
                (== (ai-math:get $index (Pending $name) AiLean:Missing) AiLean:Missing))
         (case (ai-math:lean-claim $context $hash $type)
           ((AiLean:Consistent
             (let* (($parameters (ai-math:lean-type-parameters $context $arity))
                    ($scope (AiLean:Scope $parameters () ()))
                    ($rendered (ai-math:lean-term $context $scope (if (ai-math:contains (AXIOM THM) $kind) Tm Tp) $type)))
               (if (== $kind THM)
                 (case $rendered
                   (((AiLean:Text $text)
                     (let* (($dependencies (sort-atom (collapse (match $deps (AiEntry $dep true) $dep))))
                            ($stored (ai-math:put $index (Pending $name)
                              (AiLean:Pending $hash $parameters $rendered $dependencies)))) AiLean:PendingProof))
                    ($request $request)))
                 (ai-math:lean-entry $context $kind $name $hash $parameters $rendered
                   (if (== $kind DEF) (ai-math:lean-term $context $scope Tm $body) (AiLean:Text ""))))))
            ($request $request)))
         (AiLean:Request duplicate-declaration $name))
       (AiLean:Request invalid-declaration-header $name))))

(= (ai-math:lean-read-form $line)
   (let $text (str:trim $line)
     (if (str:starts-with $text "(")
       (case (catch (parse $text))
         (((Error $reason $where) (AiLean:Request malformed-record $line))
          ($form (case $form
            (((DELTA $hash) (if (== (get-type $hash) String) AiSkip (AiLean:Request invalid-metadata $form)))
             ((USESKNOWN $hash) (if (== (get-type $hash) String) AiSkip (AiLean:Request invalid-metadata $form)))
             ((QED) AiSkip)
             ($record (ai-math:without-source-line $record))))))) AiSkip)))
(= (ai-math:lean-export-lines $lines)
   (case $lines
     (((Error $reason $where) $lines)
      ($input
       (let* (($context (ai-math:lean-context))
              ($reserved (ai-math:put (index-atom $context 1) (Name "set") true))
              ($state (foldl-atom $input (AiLean:Entries ()) $previous $line
                (case $previous
                  (((AiLean:Entries $entries)
                    (case (ai-math:lean-read-form $line)
                      ((AiSkip $previous)
                       ((AiLean:Request $why $detail) (AiLean:Request $why $detail))
                       ((Error $why $where) (AiLean:Request invalid-record $line))
                       ($form (case (ai-math:lean-declaration $context $form)
                         ((AiLean:PendingProof $previous)
                          ((AiLean:Entry $k $n $text $deps)
                           (AiLean:Entries (cons-atom (AiLean:Entry $k $n $text $deps) $entries)))
                          ($request $request)))))))
                   ($request $request)))))
              ($pending (collapse (match (index-atom $context 1) (AiEntry (Pending $name) $value) $name))))
         (if (== $pending ())
           (case $state (((AiLean:Entries $entries) (AiLean:Entries (list:reverse $entries))) ($request $request)))
           (case $state (((AiLean:Entries $entries) (AiLean:Request missing-proofs $pending)) ($request $request)))))))))
(= (ai-math:lean-export $path) (ai-math:lean-export-lines (fs:read-lines $path)))
(= (ai-math:lean-export-text $text) (ai-math:lean-export-lines (str:split "\n" $text)))
(= (ai-math:lean-render $export)
   (case $export
     (((AiLean:Entries $entries)
       (str:join "\n" (union-atom
         ("set_option maxRecDepth 8000" "namespace Megalodon" "axiom set : Type")
         (union-atom (map-atom $entries $entry (index-atom $entry 3)) ("end Megalodon" "")))))
      ($request $request))))
