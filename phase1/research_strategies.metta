; Optional experimental tactic profiles; each is still an ordinary candidate.
(= (ai-math:research-source-aliases (AiProver $s (AiTHF $n $index $formats) $itp $v $policy))
   (let* (($aliases (new-space))
          ($hashes (map-atom (collapse (match $index (AiTHF:Entry Hash $hash $i $name) ($hash $name))) $row
            (let ($hash $name) $row (ai-math:put $aliases (Hash $hash) $name))))
          ($primitives (map-atom (collapse (match $index (AiTHF:Entry Primitive $id $i $name) ($id $name))) $row
            (let ($id $name) $row (ai-math:put $aliases (Primitive $id) $name))))) $aliases))
(= (ai-math:research-source-goal $context $aliases $parent $statement)
   (let $index (index-atom (ai-math:get (index-atom (index-atom $context 3) 1) $parent AiMissing) 1)
     (AiSearchFact $index THM $parent (ai-math:collect $statement $aliases false) ()
       (ai-math:features $statement $aliases))))
(= (ai-math:research-source-hints $context $aliases $parent $statement $options)
   (let* (((AiProver $search $thf $itp $vampire $policy) $context)
          ($query (ai-math:research-source-goal $context $aliases $parent $statement))
          ($index (ai-math:declaration-index $query))
          ($slices (ai-math:option $options slices (16 32 64 128 256 512)))
          ($limit (foldl-atom $slices 64 $size $k (if (> $k $size) $k $size)))
          ($ranked (ai-math:entry-names (ai-math:rank-for $search $index $query $limit ())))
          ($facts (filter-atom $ranked $name (case (ai-math:get (index-atom $itp 1) $name AiMissing)
             (((AiITP:Declaration $i $kind) (ai-math:contains (THM AXIOM) $kind)) ($other false)))))
          ($defs (ai-math:prover-goal-defs $thf $query))
          ($advice (ai-math:ind-case-advice $thf $statement $ranked $slices $vampire
            (ai-math:option $options seconds 30) (ai-math:option $options definition-depth 3) ())))
     (case $advice
       (((AiInd:CaseAdvice $premises $trace) (AiProver:Hints (unique-atom ($premises (list:take 8 $facts))) $defs $defs "Theorem" $trace))
        ((AiInd:NoCaseAdvice $trace) (AiProver:Hints ((list:take 8 $facts)) $defs $defs "no-advice" $trace))))))
(= (ai-math:research-profile (AiProver $search $thf $itp $vampire $policy) $options)
   (let $choice (ai-math:option $options use-duper Auto)
     (if (or (== $choice false)
             (and (== $choice Auto) (not (ai-math:itp-duper-prepared (index-atom $itp 2)))))
       (AiProver $search $thf (ai-math:itp-select-profile $itp core) $vampire $policy)
       (case (ai-math:itp-select-profile $itp duper)
         (((AiITP $catalog $root $lean $profile)
           (AiProver $search $thf (AiITP $catalog $root $lean $profile) $vampire $policy))
          ($other $other))))))
(= (ai-math:duper2-tactics $premises $definitions)
   (ai-math:duper2-tactics $premises $definitions $definitions))
(= (ai-math:duper2-tactics $premises $definitions $goal-definitions)
   (if (== $premises ()) ()
     (let* (($facts (str:join ", " (ai-math:lean-names $premises)))
            ($bridge (ai-math:prover-bridge))
            ($unfold (if (== $goal-definitions ()) $bridge
              (str:join ", " ($bridge (str:join ", " (ai-math:lean-names $goal-definitions))))))
            ($normal (str:join "" ("intros\ntry simp only [" $bridge "] at *\nduper [" $facts "]"))))
       (union-atom
         ((AiITP:Candidate "d2-exact" (str:join "" ("intros\nduper [" $facts "]")))
          (AiITP:Candidate "d2-norm" $normal)
          (AiITP:Candidate "d2-unfold" (str:join "" ("intros\ntry simp only [" $unfold "] at *\nduper [" $facts "]")))
          (AiITP:Candidate "d2-raw" (str:join "" ("duper [" $facts "]")))
          (AiITP:Candidate "d2-full" (str:concat $normal " {preprocessing := full}"))
          (AiITP:Candidate "d2-p1" (str:concat $normal " {portfolioInstance := 1}")))
         (if (> (size-atom $premises) 2)
           ((AiITP:Candidate "d2-few" (str:join "" ("intros\ntry simp only [" $bridge "] at *\nduper ["
             (str:join ", " (ai-math:lean-names (list:take 2 $premises))) "]")))) ())))))
