; A derived goal names a real subgoal of a prefix at an original target.
; CaseAccepted is deliberately not promoted to Accepted for that target.
(= (ai-math:derived-check-batch (AiDerivedGoal $itp $parent $prefix $case) $candidates $budget)
   (ai-math:itp-case-batch-resilient $itp $parent $prefix
     (map-atom $candidates $candidate
       (let (AiITP:Candidate $label $script) $candidate (AiITP:CaseCandidate $case $label $script)))
     $budget $budget 0))
(= (ai-math:derived-check $goal $script $budget)
   (case (ai-math:derived-check-batch $goal ((AiITP:Candidate "derived" $script)) $budget)
     (((AiITP:CaseBatch $name ((AiITP:CaseAttempt $case "derived" $answer))) $answer)
      ($other $other))))
(= (ai-math:derived-state (AiDerivedGoal $itp $parent $prefix $case) $budget)
   (case (ai-math:probe-with $itp $parent $prefix $budget)
     (((AiProbe:Open $states)
       (if (and (ai-math:natural $case) (< $case (size-atom $states)))
         (AiDerived:State (index-atom $states $case) (size-atom $states))
         (AiDerived:Fault invalid-case)))
      ($other (AiDerived:Unavailable $other)))))
(= (ai-math:derived-candidates $stage $sets $definitions $goal-definitions)
   (ai-math:research-concat (map-atom (if (== $sets ()) (()) $sets) $premises
     (case $stage
       ((base (ai-math:candidate-tactics $premises $definitions $goal-definitions))
        (followup (ai-math:followup-tactics $premises $definitions $goal-definitions))
        (apply (ai-math:apply-tactics $premises $definitions))
        (apply2 (ai-math:apply2-tactics $premises $definitions))
        (duper (ai-math:duper-tactics $premises $definitions))
        (duper2 (ai-math:duper2-tactics $premises $definitions $goal-definitions))
        ($other ()))))))
(= (ai-math:derived-winner $candidates $attempts)
   (if (== $candidates ()) AiDerived:NoProof
     (let* (((AiITP:Candidate $label $script) (car-atom $candidates))
            ((AiITP:CaseAttempt $case $same $answer) (car-atom $attempts)))
       (case $answer
         (((AiITP:CaseAccepted $parent $ordinal $count $used $axioms)
           (AiDerived:Proved $label $script $answer))
          ((AiITP:Rejected $parent $why $detail)
            (ai-math:derived-winner (cdr-atom $candidates) (cdr-atom $attempts)))
          ($other
            (case (ai-math:derived-winner (cdr-atom $candidates) (cdr-atom $attempts))
              (((AiDerived:Proved $later-label $later-script $checked)
                (AiDerived:Proved $later-label $later-script $checked))
               ($later (ai-math:derived-prefer-failure $other $later))))))))))
(= (ai-math:derived-failure $answer)
   (case $answer
     (((AiITP:Rejected $n $why $detail) (AiDerived:NotProved ($answer)))
      ((AiITP:Unfinished $n $why $detail) (AiDerived:Unfinished ($answer)))
      ((AiDerived:NotProved $trace) $answer)
      ((AiDerived:Unfinished $trace) $answer)
      ((AiDerived:Fault $trace) $answer)
      ((AiPlan:NotProved $trace $why) (AiDerived:NotProved ($answer)))
      ((AiPlan:Unfinished $trace $why) (AiDerived:Unfinished ($answer)))
      ((AiProbe:Error $why) (AiDerived:NotProved ($answer)))
      ((AiProbe:Unfinished $why) (AiDerived:Unfinished ($answer)))
      ((AiDerived:Unavailable $why) (ai-math:derived-failure $why))
      (AiDerived:NoProof AiDerived:NoProof)
      ($other (AiDerived:Fault ($other))))))
; Failure is retained only after all later candidates/stages had a chance
; to supply a checked success. Faults outrank incomplete work, not proofs.
(= (ai-math:derived-prefer-failure $earlier $later)
   (case ((ai-math:derived-failure $earlier) (ai-math:derived-failure $later))
     ((((AiDerived:Fault $why) $rest) (AiDerived:Fault $why))
      (($first (AiDerived:Fault $why)) (AiDerived:Fault $why))
      (((AiDerived:Unfinished $why) $rest) (AiDerived:Unfinished $why))
      (($first (AiDerived:Unfinished $why)) (AiDerived:Unfinished $why))
      (($first $rest) $rest))))
(= (ai-math:plan-failure $trace $answer)
   (case (ai-math:derived-failure $answer)
     ((AiDerived:NoProof (AiPlan:NotProved $trace $answer))
      ((AiDerived:NotProved $why) (AiPlan:NotProved $trace $answer))
      ((AiDerived:Unfinished $why) (AiPlan:Unfinished $trace $answer))
      ($other (AiPlan:Fault (union-atom $trace ($answer)))))))
(= (ai-math:derived-can-continue $answer)
   (case (ai-math:derived-failure $answer)
     ((AiDerived:NoProof true) ((AiDerived:NotProved $trace) true) ($other false))))
(= (ai-math:derived-prove $goal $hints $options)
   (ai-math:derived-stages $goal $hints
     (filter-atom (ai-math:option $options stages (base followup apply apply2 duper duper2)) $stage
       (or (not (== (ai-math:option $options use-duper Auto) false))
           (not (ai-math:contains (duper duper2) $stage)))) $options ()))
(= (ai-math:derived-stages $goal $hints $stages $options $trace)
   (if (== $stages ()) (AiDerived:NotProved $trace)
     (let* (((AiDerivedGoal $itp $parent $prefix $case) $goal)
            ((AiProver:Hints $sets $definitions $goal-definitions $status $advice) $hints)
            ($stage (car-atom $stages))
            ($selected (if (ai-math:contains (duper duper2) $stage)
              (ai-math:itp-select-profile $itp duper) $itp))
            ($all (ai-math:derived-candidates $stage $sets $definitions $goal-definitions))
            ($limit (ai-math:option $options candidate-limit 0))
            ($candidates (if (== $limit 0) $all (list:take $limit $all))))
       (case $selected
         (((AiITP $catalog $root $lean $profile)
           (case (ai-math:derived-check-batch (AiDerivedGoal $selected $parent $prefix $case) $candidates
                   (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))
             (((AiITP:CaseBatch $name $rows)
               (case (ai-math:derived-winner $candidates $rows)
                 (((AiDerived:Proved $label $script $checked) (AiDerived:Proved $label $script $checked))
                  ($failed
                    (case (ai-math:derived-stages $goal $hints (cdr-atom $stages) $options
                            (union-atom $trace ((AiDerived:Stage $stage $rows))))
                      (((AiDerived:Proved $later-label $later-script $later-checked)
                        (AiDerived:Proved $later-label $later-script $later-checked))
                       ($later (ai-math:derived-prefer-failure $failed $later))))))))
              ($other (ai-math:derived-failure $other)))))
          ($missing (if (== (ai-math:option $options use-duper Auto) Auto)
            (ai-math:derived-stages $goal $hints (cdr-atom $stages) $options
              (union-atom $trace ((AiDerived:Stage $stage $missing))))
            (AiDerived:Fault ($missing)))))))))

; The plan language carries claims, not admissions. Holes are temporary
; metavariables in the isolated proposer; no certificate can contain them.
(= (ai-math:plan-valid $plan)
   (case $plan
     (((AiProofPlan $intro $claims)
       (and (== (get-type $intro) String)
         (and (== (get-metatype $claims) Expression)
           (and (foldl-atom $claims true $ok $claim
             (and $ok (case $claim
               (((AiClaim $name $type)
                 (and (ai-math:lean-safe-name $name) (== (get-type $type) String)))
                ($other false)))))
             (let $names (map-atom $claims $claim (index-atom $claim 1))
               (== (size-atom $names) (size-atom (unique-atom $names))))))))
      ($other false))))
(= (ai-math:plan-from-json $value)
   (if (ai-math:plan-object $value ("intro" "claims"))
    (case ((json:get $value "intro") (json:get $value "claims"))
     ((($intro (JsonArray $rows))
       (let $plan (AiProofPlan $intro (map-atom $rows $row
              (AiClaim (json:get $row "name") (json:get $row "type"))))
         (if (and (ai-math:plan-valid $plan)
                  (foldl-atom $rows true $ok $row (and $ok (ai-math:plan-object $row ("name" "type")))))
           $plan (AiPlan:Fault invalid-plan))))
      ($other (AiPlan:Fault invalid-plan)))) (AiPlan:Fault invalid-plan)))
(= (ai-math:plan-object $value $expected)
   (case $value
     (((JsonObject $pairs) (== (sort-atom (ai-math:itp-json-keys $pairs)) (sort-atom $expected)))
      ($other false))))
(= (ai-math:plan-haves $proved)
   (str:join "\n" (map-atom $proved $entry
     (let (AiPlan:Checked (AiClaim $name $type) $script $receipt) $entry
       (str:join "" ("have " (ai-math:lean-name $name) " : " $type " := by\n  "
         (str:join "\n  " (str:split "\n" $script))))))))
(= (ai-math:plan-relative-prefix (AiProofPlan $intro $claims) $proved $remaining)
   (str:join "\n" ($intro (ai-math:plan-haves $proved)
     (if (== $remaining ()) "skip"
       (str:join "" ("refine (" (str:join "" (map-atom $remaining $claim
         (let (AiClaim $name $type) $claim (str:join "" ("have " (ai-math:lean-name $name) " : " $type " := ?_; "))))) "?_)"))))))
(= (ai-math:plan-base-prefix (AiDerivedGoal $itp $parent $prefix $case))
   (str:join "\n" ($prefix (str:concat "rotate_left " (str:number->string $case)))))
(= (ai-math:plan-prove $context $goal $plan $hints $options)
   (if (ai-math:plan-valid $plan)
     (ai-math:plan-claims $context $goal $plan $hints $options (index-atom $plan 2) () ())
     (AiPlan:Fault invalid-plan)))
(= (ai-math:plan-claims $context $goal $plan $hints $options $remaining $proved $trace)
   (let* (((AiDerivedGoal $itp $parent $prefix $case) $goal)
          ($relative (ai-math:plan-relative-prefix $plan $proved $remaining))
          ($claim-goal (AiDerivedGoal $itp $parent (str:join "\n" ((ai-math:plan-base-prefix $goal) $relative)) 0)))
     (if (== $remaining ())
       (case (ai-math:plan-prove-claim $context $claim-goal (AiClaim "__final" "") $hints $options)
         (((AiDerived:Proved $label $script $receipt)
           (let* (($assembled (str:join "\n" ((index-atom $plan 1) (ai-math:plan-haves $proved) $script)))
                  ($checked (ai-math:derived-check $goal $assembled
                    (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))))
             (case $checked
               (((AiITP:CaseAccepted $n $i $count $u $a) (AiPlan:Proved $assembled $checked $trace))
                ($other (ai-math:plan-failure $trace $other))))))
          ($other (ai-math:plan-failure $trace $other))))
       (let $result (ai-math:plan-prove-claim $context $claim-goal (car-atom $remaining) $hints $options)
         (case $result
           (((AiDerived:Proved $label $script $receipt)
             (ai-math:plan-claims $context $goal $plan $hints $options (cdr-atom $remaining)
               (union-atom $proved ((AiPlan:Checked (car-atom $remaining) $script $receipt)))
               (union-atom $trace ((AiPlan:Step (car-atom $remaining) $result)))))
            ($other (if (and (ai-math:option $options skip-failed false)
                         (case (ai-math:derived-failure $other)
                           ((AiDerived:NoProof true) ((AiDerived:NotProved $why) true) ($unknown false))))
              (ai-math:plan-claims $context $goal $plan $hints $options (cdr-atom $remaining) $proved
                (union-atom $trace ((AiPlan:Step (car-atom $remaining) $other))))
              (ai-math:plan-failure (union-atom $trace ((AiPlan:Step (car-atom $remaining) $other))) $other)))))))))
(= (ai-math:plan-prove-claim $context $goal $claim $hints $options)
   (let* (($cache (ai-math:option $options cache NoPlanCache))
          ($cached (if (== $cache NoPlanCache) NoCachedScript (ai-math:get $cache $goal NoCachedScript)))
          ($prior (if (== $cached NoCachedScript) AiDerived:NoProof
                    (ai-math:plan-check-proposal $goal "cached" $cached $options)))
          ($result (if (== $prior AiDerived:NoProof)
                     (ai-math:plan-uncached-claim $context $goal $claim $hints $options) $prior)))
     (case $result
       (((AiDerived:Proved $label $script $checked)
         (let $stored (if (== $cache NoPlanCache) () (ai-math:put $cache $goal $script)) $result))
        ($other $other)))))
(= (ai-math:plan-check-proposal $goal $label $script $options)
   (case (ai-math:derived-check $goal $script
           (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))
     (((AiITP:CaseAccepted $n $i $count $u $a)
       (AiDerived:Proved $label $script (AiITP:CaseAccepted $n $i $count $u $a)))
      ((AiITP:Rejected $n $why $detail) AiDerived:NoProof)
      ($other (ai-math:derived-failure $other)))))
(= (ai-math:plan-uncached-claim $context $goal $claim $hints $options)
   (let* (($final (ai-math:option $options final-script NoFinalScript))
          ($closing (if (and (== (index-atom $claim 1) "__final") (not (== $final NoFinalScript)))
                     (ai-math:plan-check-proposal $goal "assembled" $final $options) AiDerived:NoProof)))
     (if (== $closing AiDerived:NoProof)
       (case (ai-math:derived-prove $goal $hints $options)
         (((AiDerived:Proved $label $script $checked) (AiDerived:Proved $label $script $checked))
          ($failed (case (ai-math:derived-failure $failed)
            (((AiDerived:NotProved $trace) (ai-math:plan-external-claim $context $goal $claim $hints $options $failed))
             (AiDerived:NoProof (ai-math:plan-external-claim $context $goal $claim $hints $options $failed))
             ($stop $stop)))))) $closing)))
(= (ai-math:plan-external-claim $context $goal $claim $hints $options $failed)
   ; Extension symbols are resolved in their explicit definition space.
   ; A returned receipt is advice; check the script in this actual goal.
   (case (ai-math:option $options claim-handler NoClaimHandler)
     (((AiPlan:Handler $space $function)
       (case (evalc ($function $context $goal $claim $hints $options $failed) $space)
         (((AiDerived:Proved $label $script $advice)
           (case (ai-math:derived-check $goal $script
                   (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))
             (((AiITP:CaseAccepted $n $i $count $used $axioms)
               (AiDerived:Proved $label $script (AiITP:CaseAccepted $n $i $count $used $axioms)))
              ($other (ai-math:derived-failure $other)))))
          ($other (ai-math:derived-failure $other)))))
      ($other $failed))))
(= (ai-math:decompose-plan $context $target $plan $hints $options)
   (case (ai-math:research-profile $context $options)
     (((AiProver $search $thf $itp $vampire $policy)
       (ai-math:decompose-plan-ready (AiProver $search $thf $itp $vampire $policy) $target $plan $hints $options))
      ($other (AiDecomp:Fault $other)))))
(= (ai-math:decompose-plan-ready (AiProver $search $thf $itp $vampire $policy) $target $plan $hints $options)
   (case (ai-math:plan-prove (AiProver $search $thf $itp $vampire $policy)
           (AiDerivedGoal $itp $target "skip" 0) $plan $hints $options)
     (((AiPlan:Proved $script $case-receipt $trace)
       (AiDecomp:Result $target $plan $trace $script
         (ai-math:itp-check-with $itp $target $script
           (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))))
      ($other (AiDecomp:Result $target $plan () "" $other)))))
