; Explicit, budgeted OpenAI-compatible chat proposals. Import io,
; http_transport.metta and the normal application JSON/process APIs first.
; The client holds credentials in a local space, not in printable results.

(= (ai-math:llm-options-valid $options)
   (if (== (get-metatype $options) Expression)
     (foldl-atom $options true $ok $entry
       (and $ok (case $entry
         ((($key $value)
           (case $key
             ((token-field (ai-math:contains ("max_tokens" "max_completion_tokens") $value))
              (temperature (if (== (get-type $value) Number) (and (>= $value 0) (<= $value 2)) false))
              ($count (if (ai-math:contains (max-tokens timeout-ms max-bytes ledger-timeout-ms retry-delay-seconds) $count)
                        (ai-math:itp-natural $value) false)))))
          ($other false))))) false))
(= (ai-math:llm-client $root $session $endpoint $model $secret $ledger $cap $options)
   (if (and (== (get-type $endpoint) String)
        (and (== (get-type $model) String) (and (== (get-type $secret) String)
          (and (== (get-type $ledger) String)
            (and (ai-math:itp-natural $cap) (ai-math:llm-options-valid $options))))))
     (let $config (new-space)
       (let $stored (map-atom
          ((Root $root) (Endpoint $endpoint) (Model $model) (Secret $secret) (Ledger $ledger)
           (Cap $cap) (Options $options) (Binary (fs:canonical-path "/proc/self/exe"))) $entry
           (let ($key $value) $entry (ai-math:put $config $key $value)))
         (AiLLM $config $session))) (AiLLM:Fault invalid-client)))
(= (ai-math:llm-config (AiLLM $config $session) $key) (ai-math:get $config $key AiLLM:Missing))
(= (ai-math:llm-process-json $observation)
   (case $observation
     (((proc:result (proc:exited 0) proc:normal $out $err
         (proc:capture $seen $kept $es $ek proc:eof proc:eof (proc:input $size $sent)))
       (if (and (== $seen $kept) (and (== $es $ek) (== $size $sent)))
         (json-parse $out) (AiLLM:Fault ledger-capture)))
      ($other (AiLLM:Fault ledger-process)))))
(= (ai-math:llm-ledger-call $client $request)
   (let* (($root (ai-math:llm-config $client Root)) ($ledger (ai-math:llm-config $client Ledger))
          ($binary (ai-math:llm-config $client Binary))
          ($options (ai-math:llm-config $client Options)))
     (ai-math:llm-process-json
       (proc:run ("flock" "--exclusive" (str:concat $ledger ".lock") $binary
                   "--no-results" "--lang" "petta@1.0.6" (str:concat $root "/phase1/llm_ledger_main.metta") $ledger)
         ((stdin (json-stringify $request))
          (timeout-ms (ai-math:option $options ledger-timeout-ms 30000)))))))
(= (ai-math:llm-reserve $client)
   (case (ai-math:llm-ledger-call $client (JsonObject
           ((JsonPair "operation" (JsonString "reserve"))
            (JsonPair "model" (JsonString (ai-math:llm-config $client Model)))
            (JsonPair "cap" (JsonNumber (str:number->string (ai-math:llm-config $client Cap)))))))
     (((JsonObject $fields)
       (let $reply (JsonObject $fields)
         (case (json-object-get $reply "kind")
           (((JsonString "reserved")
             (case (json-object-get $reply "n")
               (((JsonNumber $n) (let $value (str:string->number $n)
                  (if (and (ai-math:itp-natural $value)
                           (and (> $value 0) (<= $value (ai-math:llm-config $client Cap)))) (AiLLM:Reserved $value)
                    (AiLLM:Fault ledger-protocol)))) ($other (AiLLM:Fault ledger-protocol)))))
            ((JsonString "limit") (AiLLM:Limit (ai-math:llm-config $client Cap)))
            ($other (AiLLM:Fault ledger))))))
      ($other (AiLLM:Fault ledger)))))
(= (ai-math:llm-record-usage $client $reservation $usage $elapsed)
   (case (ai-math:llm-ledger-call $client (JsonObject
           ((JsonPair "operation" (JsonString "usage"))
            (JsonPair "model" (JsonString (ai-math:llm-config $client Model)))
            (JsonPair "n" (JsonNumber (str:number->string $reservation)))
            (JsonPair "usage" $usage) (JsonPair "nanoseconds" (JsonNumber (str:number->string $elapsed))))))
     (((JsonObject ((JsonPair "kind" (JsonString "usage-recorded")))) AiLLM:UsageRecorded)
      ($other (AiLLM:Fault usage-record)))))
(= (ai-math:llm-endpoint $endpoint)
   (if (str:ends-with $endpoint "/")
     (ai-math:llm-endpoint (str:byte-slice $endpoint 0 (- (str:byte-length $endpoint) 1)))
     (str:concat $endpoint "/chat/completions")))
(= (ai-math:llm-safe-usage $usage)
   (JsonObject (map-atom ("prompt_tokens" "completion_tokens" "total_tokens") $key
     (JsonPair $key (case (json-object-get $usage $key)
       (((JsonNumber $value)
         (if (ai-math:itp-natural (str:string->number $value)) (JsonNumber $value) JsonNull))
        ($other JsonNull)))))))
(= (ai-math:llm-decode $client $response)
   (case $response
     (((AiHTTP:Response $status $body)
       (if (and (>= $status 200) (< $status 300))
         (let $json (json-parse $body)
           (case (json-object-get $json "choices")
             (((JsonArray $choices)
               (if (== $choices ()) (AiLLM:Fault response-shape)
                 (let $message (json-object-get (car-atom $choices) "message")
                   (case (json-object-get $message "content")
                     (((JsonString $text)
                       (let $secret (ai-math:llm-config $client Secret)
                         (if (and (> (str:byte-length $secret) 0) (> (size-atom (str:split $secret $text)) 1))
                           (AiLLM:Fault credential-in-response)
                           (AiLLM:Decoded $text (json-object-get $json "usage")))))
                      (JsonNull (AiLLM:Decoded "" (json-object-get $json "usage")))
                      ($other (AiLLM:Fault response-shape)))))))
              ($other (AiLLM:Fault response-shape)))))
         (AiLLM:HTTPStatus $status)))
      ($other $other))))
(= (ai-math:llm-call $client $messages)
   (if (ai-math:contains (io:capabilities) http)
     (case (ai-math:llm-reserve $client)
       (((AiLLM:Reserved $reservation)
         (let* (($model (ai-math:llm-config $client Model)) ($secret (ai-math:llm-config $client Secret))
                ($options (ai-math:llm-config $client Options))
                ($body (json-stringify (JsonObject
                  ((JsonPair "model" (JsonString $model)) (JsonPair "messages" (JsonArray $messages))
                   (JsonPair (ai-math:option $options token-field "max_tokens")
                     (JsonNumber (str:number->string (ai-math:option $options max-tokens 16000))))
                   (JsonPair "temperature" (JsonNumber (str:number->string (ai-math:option $options temperature 0.2))))))))
                ($start (system:monotonic-ns))
                ($session (index-atom $client 2))
                ($url (ai-math:llm-endpoint (ai-math:llm-config $client Endpoint)))
                ($authorization (str:concat "Bearer " $secret))
                ($headers ((http:header "Content-Type" "application/json") (http:header "Authorization" $authorization)))
                ($timeout (ai-math:option $options timeout-ms 180000))
                ($max-bytes (ai-math:option $options max-bytes 8388608))
                ($response (ai-math:http-request $session "POST" $url $headers $body $timeout $max-bytes))
                ($elapsed (- (system:monotonic-ns) $start))
                ($decoded (ai-math:llm-decode $client $response))
                ($usage (case $decoded
                  (((AiLLM:Decoded $text $tokens) (ai-math:llm-safe-usage $tokens)) ($other JsonNull))))
                ($recorded (ai-math:llm-record-usage $client $reservation $usage $elapsed)))
           (case $decoded
             (((AiLLM:Decoded $text $tokens) (AiLLM:Reply $text (AiLLM:Receipt $reservation $usage $recorded)))
              ($other (AiLLM:AttemptFailed $reservation $other $recorded))))))
        ($other $other))) (AiLLM:ProviderRequest http)))
(= (ai-math:llm-chat-ready $client $messages $retries)
   (if (and (ai-math:itp-natural $retries) (> $retries 0))
     (let $result (ai-math:llm-call $client $messages)
       (case $result
         (((AiLLM:AttemptFailed $n $reason $usage)
           (if (> $retries 1)
             (let $waited (proc:run ("sleep" (str:number->string
                                  (ai-math:option (ai-math:llm-config $client Options) retry-delay-seconds 2))) ())
               (ai-math:llm-chat-ready $client $messages (- $retries 1))) $result))
          ($other $other)))) (AiLLM:Fault retry-policy)))
(= (ai-math:llm-chat $client $messages $retries)
   (case $client
     (((AiLLM $config $session) (ai-math:llm-chat-ready $client $messages $retries))
      ($other $other))))
