; A shared mailbox owns the application's io:poll queue. All clients of the
; queue share this session; interleaved completions are retained by ID.
; Waiting uses the existing process wait operation, not a busy poll loop.

(= (ai-math:http-session) (AiHTTP (new-space)))
(= (ai-math:http-result $result)
   (case $result
     (((http:response $status $body) (AiHTTP:Response $status $body))
      ((Error $source (http:error transport 28 $message)) (AiHTTP:Unfinished deadline))
      ((Error $source (http:error response-too-large $limit)) (AiHTTP:Unfinished response-limit))
      ((Error $source (http:error transport $code $message)) (AiHTTP:Fault transport $code))
      ($other (AiHTTP:Fault response ())))))
(= (ai-math:http-pump (AiHTTP $mailbox) $wanted $timer)
   (let $saved (ai-math:get $mailbox $wanted AiHTTP:Missing)
     (if (== $saved AiHTTP:Missing)
       (case (io:poll)
         (((io:event $id $result)
           (if (== $id $wanted) (ai-math:http-result $result)
             (let $stored (ai-math:put $mailbox $id $result)
               (ai-math:http-pump (AiHTTP $mailbox) $wanted $timer))))
          ((io:idle)
           (case (proc:wait $timer 10)
             ((proc:pending (ai-math:http-pump (AiHTTP $mailbox) $wanted $timer))
              ($other (AiHTTP:Fault wait-process ())))))
          ($other (AiHTTP:Fault poll ()))))
       (let $removed (ai-math:remove $mailbox $wanted) (ai-math:http-result $saved)))))
(= (ai-math:http-await $session $id)
   (let* (($timer (proc:spawn ("sleep" "infinity") ()))
          ($result (ai-math:http-pump $session $id $timer))
          ($aborted (case $result
            (((AiHTTP:Fault $why $details) (io:cancel $id)) ($other ()))))
          ($cancelled (proc:cancel $timer)) ($closed (proc:close $timer))) $result))
(= (ai-math:http-request $session $method $url $headers $body $milliseconds $max-bytes)
   (if (ai-math:contains (io:capabilities) http)
     (case (io:submit (http:request $method $url $headers $body $milliseconds $max-bytes))
       (((io:pending $id) (ai-math:http-await $session $id))
        ((Error $request $message) (AiHTTP:Fault submission $message))
        ($other (AiHTTP:Fault submission ()))))
     (AiHTTP:ProviderRequest http)))
