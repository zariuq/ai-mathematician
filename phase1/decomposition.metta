; Plans and local lemma proposals are advisory. Every subgoal proof is
; checked in its actual context; publication rechecks the assembled target.
(= (ai-math:research-option $options $key $value)
   (cons-atom ($key $value) (filter-atom $options $entry (not (== (car-atom $entry) $key)))))
(= (ai-math:derived-llm $context $client $goal $hints $rounds $options)
   (let* (((AiDerivedGoal $itp $parent $prefix $case) $goal)
          ((AiProver:Hints $sets $definitions $gd $status $trace) $hints)
          ($budget (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))
          ($premises (unique-atom (ai-math:research-concat $sets))))
     (case (ai-math:itp-prompt-context $itp $parent $premises $definitions $budget)
       (((AiITP:PromptContext $name $statement $defs $facts)
         (case (ai-math:derived-state $goal $budget)
           (((AiDerived:State $state $count)
             (let $messages ((ai-math:llm-message "system" (ai-math:llm-system))
                    (ai-math:llm-message "user" (str:join "\n"
                      ((ai-math:llm-prompt-with (AiITP:PromptContext $name $statement $defs $facts)
                         (ai-math:llm-config $client Options))
                       "Prove ONLY this selected subgoal in its displayed local context:" $state))))
               (ai-math:derived-llm-loop $client $goal $messages $premises $rounds $budget ())))
            ($other (ai-math:derived-failure $other)))))
        ($other (ai-math:derived-failure $other))))))
(= (ai-math:derived-llm-loop $client $goal $messages $premises $rounds $budget $trace)
   (if (== $rounds 0) (AiDerived:NotProved $trace)
     (case (ai-math:llm-chat $client $messages
             (ai-math:option (ai-math:llm-config $client Options) retries 4))
       (((AiLLM:Reply $text $receipt)
         (let* (($parser (ai-math:llm-code-parser))
                ($script (ai-math:llm-normalize $parser (ai-math:llm-extract $parser $text)))
                ($answer (ai-math:derived-check $goal $script $budget)))
           (case $answer
             (((AiITP:CaseAccepted $name $case $count $used $axioms) (AiDerived:Proved "lemma-llm" $script $answer))
              ((AiITP:Rejected $name $why $details)
                (ai-math:derived-llm-repair $client $goal $messages $premises $rounds $budget $trace
                  $parser $script $answer $receipt))
              ($other (ai-math:derived-failure $other))))))
        ($other (AiDerived:Unfinished (union-atom $trace ((AiDerived:Provider $other)))))))))
(= (ai-math:derived-llm-repair $client $goal $messages $premises $rounds $budget $trace $parser $script $answer $receipt)
   (let* (($why (ai-math:llm-error-text $answer))
          ($variants (union-atom (if (> (size-atom (str:split "No goals to be solved" $why)) 1)
                                  (ai-math:llm-trims $script) ())
            (ai-math:llm-repair-variants $parser $script $why $premises "lemma")))
          ($checked (if (== $variants ()) (AiITP:CaseBatch (index-atom $goal 2) ())
                      (ai-math:derived-check-batch $goal $variants $budget)))
          ($winner (case $checked
            (((AiITP:CaseBatch $name $rows) (ai-math:derived-winner $variants $rows))
             ($other (ai-math:derived-failure $other))))))
     (if (== $winner AiDerived:NoProof)
       (ai-math:derived-llm-loop $client $goal
         (union-atom $messages ((ai-math:llm-message "assistant" (str:join "" ("```lean\n" $script "\n```")))
           (ai-math:llm-message "user" (str:concat "Lean rejected that local proof. Repair it.\n"
              (ai-math:llm-feedback (index-atom $goal 1) (index-atom $goal 2) $why $budget 2500)))))
         $premises (- $rounds 1) $budget (union-atom $trace ((AiDerived:Proposal $script $answer $receipt)))) $winner)))
(= (ai-math:decompose-prompt $context $client $goal $hints $budget)
   (let* (((AiProver $search $thf $itp $vampire $options) $context)
          ((AiDerivedGoal $owner $parent $prefix $case) $goal)
          ((AiProver:Hints $sets $definitions $gd $status $trace) $hints)
          ($names (unique-atom (ai-math:research-concat $sets))))
     (case (ai-math:itp-prompt-context $itp $parent $names $definitions $budget)
       (((AiITP:PromptContext $name $statement $defs $facts)
         (case (ai-math:derived-state $goal $budget)
           (((AiDerived:State $state $count)
             (ai-math:llm-proof-prompt $search $itp $parent
               (str:join "\n" ((ai-math:llm-prompt-with (AiITP:PromptContext $name $statement $defs $facts)
                   (ai-math:llm-config $client Options)) "Selected subgoal and local context:" $state))
               (ai-math:llm-config $client Options) $budget))
            ($other $other))))
        ($other $other)))))
(= (ai-math:decompose-goal $context $client $goal $hints $options)
   (let* (($budget (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))
          ($cache (ai-math:option $options cache (new-space)))
          ($policy (ai-math:research-option
            (ai-math:research-option (ai-math:research-option $options client $client) cache $cache)
            claim-handler (AiPlan:Handler &self ai-math:plan-extended-claim))))
     (case (ai-math:decompose-prompt $context $client $goal $hints $budget)
       (((AiLLM:Prompt $prompt)
         (case (ai-math:llm-chat $client ((ai-math:llm-message "system" (ai-math:dsp-system))
                 (ai-math:llm-message "user" $prompt)) 4)
           (((AiLLM:Reply $draft $receipt)
             (let $messages ((ai-math:llm-message "system"
                 "Return one JSON object with exactly intro (a Lean tactic string introducing the goal's binders) and claims (an array of objects with name and type strings). State small intermediate propositions in their actual local context. No proof admissions, no commands, no target theorem citation. An independent prover will prove the claims and final goal.")
               (ai-math:llm-message "user" (str:join "\n" ($prompt "Informal draft:" $draft))))
               (ai-math:decompose-loop $context $client $goal $hints $policy $messages
                 (+ 1 (ai-math:option $options repair-rounds 2)) ((AiDecomp:Draft $draft $receipt)))))
            ($other (AiPlan:Unfinished () $other)))))
        ($other (ai-math:plan-failure () $other))))))
(= (ai-math:decompose-json $text)
   (case (json:parse $text)
     (((JsonObject $pairs) (ai-math:plan-from-json (JsonObject $pairs)))
      ($other (let* (($parser (ai-math:llm-code-parser))
                     ($body (ai-math:llm-extract $parser $text))
                     ($plain (if (str:starts-with $body "json\n")
                       (str:byte-slice $body 5 (str:byte-length $body)) $body)))
                (ai-math:plan-from-json (json:parse $plain)))))))
(= (ai-math:decompose-loop $context $client $goal $hints $options $messages $remaining $trace)
   (if (== $remaining 0) (AiPlan:NotProved $trace exhausted-plans)
     (case (ai-math:llm-chat $client $messages 4)
       (((AiLLM:Reply $text $receipt)
         (let* (($plan (ai-math:decompose-json $text))
                ($result (if (and (ai-math:plan-valid $plan)
                              (<= (size-atom (index-atom $plan 2)) (ai-math:option $options max-claims 12)))
                           (ai-math:plan-prove $context $goal $plan $hints $options)
                           (AiPlan:Fault invalid-or-excessive-plan)))
                ($next (union-atom $trace ((AiDecomp:Plan $plan $result $receipt)))))
           (case $result
             (((AiPlan:Proved $script $checked $detail) (AiPlan:Proved $script $checked (union-atom $next $detail)))
              ((AiPlan:NotProved $detail $why)
                (ai-math:decompose-retry $context $client $goal $hints $options $messages $remaining $next $text))
              ((AiPlan:Fault invalid-or-excessive-plan)
                (ai-math:decompose-retry $context $client $goal $hints $options $messages $remaining $next $text))
              ($stop $stop)))))
        ($other (AiPlan:Unfinished $trace $other))))))
(= (ai-math:decompose-retry $context $client $goal $hints $options $messages $remaining $trace $text)
   (ai-math:decompose-loop $context $client $goal $hints $options
     (union-atom $messages ((ai-math:llm-message "assistant" $text)
       (ai-math:llm-message "user" "The plan was invalid or its claims were not proved. Replace hard claims with smaller claims; return the same JSON format.")))
     (- $remaining 1) $trace))
(= (ai-math:decompose-rounds $context $client $target $hints $options)
   (case (ai-math:research-profile $context $options)
     (((AiProver $search $thf $itp $vampire $policy)
       (ai-math:decompose-rounds-ready (AiProver $search $thf $itp $vampire $policy) $client $target $hints $options))
      ($other (AiDecomp:Fault $other)))))
(= (ai-math:decompose-rounds-ready (AiProver $search $thf $itp $vampire $policy) $client $target $hints $options)
   (case (ai-math:decompose-goal (AiProver $search $thf $itp $vampire $policy) $client
           (AiDerivedGoal $itp $target "skip" 0) $hints $options)
     (((AiPlan:Proved $script $checked $trace)
       (AiDecomp:Result $target AiDecomp:GeneratedPlan $trace $script
         (ai-math:itp-check-with $itp $target $script
           (ai-math:option $options budget (AiITP:Budget 120000 200000 8000)))))
      ($other (AiDecomp:Result $target AiDecomp:GeneratedPlan () "" $other)))))
(= (ai-math:plan-extended-claim $context $goal $claim $hints $options $failed)
   (let $client (ai-math:option $options lemma-client (ai-math:option $options client AiLLM:Disabled))
     (case $client
       (((AiLLM $configuration $session)
         (case (ai-math:derived-llm $context $client $goal $hints (ai-math:option $options lemma-rounds 3) $options)
           (((AiDerived:Proved $label $script $checked) (AiDerived:Proved $label $script $checked))
            ((AiDerived:NotProved $trace) (if (> (ai-math:option $options depth 1) 0)
              (case (ai-math:decompose-goal $context $client $goal $hints
                      (ai-math:research-option $options depth (- (ai-math:option $options depth 1) 1)))
                (((AiPlan:Proved $script $checked $nested-trace) (AiDerived:Proved "nested-plan" $script $checked))
                 ($failure (ai-math:derived-failure $failure)))) (AiDerived:NotProved $trace)))
            ($stop $stop))))
        ($other $failed)))))
