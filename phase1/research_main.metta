; One native entry point for the experimental algorithms. Goals are explicit;
; selecting the whole corpus requires full_discovery=true in configuration.
!(import! &self proc)
!(import! &self io)
!(import! &self "library.metta")
!(import! &self (library list))
!(import! &self (library lib_tptp))
!(import! &self (library embedding))
!(import! &self re)
!(import! &self json)
!(import! &self system)
!(import! &self "vampire_output.metta")
!(import! &self "search.metta")
!(import! &self "atp.metta")
!(import! &self "itp.metta")
!(import! &self "proof_strategy.metta")
!(import! &self "induction.metta")
!(import! &self "smt_bridge.metta")
!(import! &self "induction_prover.metta")
!(import! &self "prover.metta")
!(import! &self "proof_advice.metta")
!(import! &self "experiment.metta")
!(import! &self "lean_export.metta")
!(import! &self "http_transport.metta")
!(import! &self "llm_transport.metta")
!(import! &self "llm.metta")
!(import! &self "prop_synth.metta")
!(import! &self "research_strategies.metta")
!(import! &self "proof_state.metta")
!(import! &self "incremental.metta")
!(import! &self "alternative_atp.metta")
!(import! &self "proof_plans.metta")
!(import! &self "decomposition.metta")
!(import! &self "oracle_chains.metta")
!(import! &self "hybrid_induction.metta")
!(import! &self "embedding_python.metta")
!(import! &self "research_analysis.metta")
!(import! &self "research.metta")

(= (ai-research:option $row $key $default)
   (let $value (json:get $row $key) (if (== $value JsonNull) $default $value)))
(= (ai-research:options $object)
   (case $object
     (((JsonObject $fields)
       (map-atom $fields $field
         (let* (((JsonPair $name $value) $field)
                ($key (str:string->symbol (str:join "-" (str:split "_" $name)))))
           ($key (case $key
             ((stages (map-atom (json:array-items $value) $s (str:string->symbol $s)))
              (budget (case $value (((JsonArray ($a $b $c)) (AiITP:Budget $a $b $c)) ($other InvalidOption))))
              (probe-budget (case $value (((JsonArray ($a $b $c)) (AiITP:Budget $a $b $c)) ($other InvalidOption))))
              (check-budget (case $value (((JsonArray ($a $b $c)) (AiITP:Budget $a $b $c)) ($other InvalidOption))))
              (slices (json:array-items $value)) (smt-slices (json:array-items $value))
              (use-duper (if (== $value "Auto") Auto $value))
              (definition-depth (if (== $value "All") All $value))
              ($other $value)))))))
      ($other InvalidOptions))))
(= (ai-research:options-valid $options)
   (if (== (get-metatype $options) Expression)
     (foldl-atom $options true $ok $entry
       (let ($key $value) $entry
         (and $ok (case $key
           ((stages (foldl-atom $value true $yes $stage
              (and $yes (ai-math:contains (base followup apply apply2 duper duper2) $stage))))
            (use-duper (ai-math:contains (true false Auto) $value))
            (definition-depth (or (== $value All) (ai-math:natural $value)))
            (slices (foldl-atom $value true $yes $n (and $yes (ai-math:natural $n))))
            (smt-slices (foldl-atom $value true $yes $n (and $yes (ai-math:natural $n))))
            ($other (if (ai-math:contains (budget probe-budget check-budget) $key) (ai-math:itp-budget-valid $value)
              (if (ai-math:contains (max-depth max-probes beam k chunk-size deadline-ms depth splits seconds
                    candidate-limit repair-rounds lemma-rounds max-claims premise-limit limit) $key)
                (ai-math:natural $value)
                (if (ai-math:contains (skip-failed direct) $key) (ai-math:contains (true false) $value)
                  (if (ai-math:contains (zipper zipper-mode) $key) (== (get-type $value) String) false)))))))))) false))
(= (ai-research:selectors-valid $row)
   (and (ai-math:run-unique-object (ai-research:option $row "options" (JsonObject ())))
     (and (case (ai-research:option $row "goals" (JsonArray ()))
            (((JsonArray $names) (ai-math:itp-string-array $names)) ($other false)))
       (foldl-atom ("lean" "vampire" "endpoint" "model" "ledger" "cache_file" "vectors_file") true $ok $key
         (and $ok (== (get-type (ai-research:option $row $key "")) String))))))
(= (ai-research:valid $row $options)
   (and (ai-math:run-unique-object $row)
     (and (foldl-atom (json:object-pairs $row) true $ok $field
       (and $ok (ai-math:contains ("mode" "corpus" "output" "goals" "full_discovery" "resume" "options"
         "lean" "vampire" "model" "endpoint" "call_cap" "ledger" "dimension" "cache_file" "vectors_file") (index-atom $field 1))))
         (and (ai-math:contains ("prop" "incremental" "decompose" "hybrid" "chain" "duper2" "zipper" "oracle" "embedding"
               "witness" "proof-profile" "oracle-premises" "recall")
              (ai-research:option $row "mode" "prop"))
         (and (foldl-atom ("corpus" "output") true $ok $key (and $ok (== (get-type (json:get $row $key)) String)))
           (and (ai-research:options-valid $options)
             (and (ai-math:natural (ai-research:option $row "call_cap" 0))
               (and (ai-math:contains (true false) (ai-research:option $row "resume" false))
                    (ai-math:contains (true false) (ai-research:option $row "full_discovery" false))))))))))
(= (ai-research:client $row $root $mode)
   (if (ai-math:contains (decompose embedding) $mode)
     (ai-math:llm-client $root (ai-math:http-session)
       (ai-research:option $row "endpoint" (system:getenv-or-default "LLM_BASE_URL" ""))
       (ai-research:option $row "model" "supplied") (system:getenv-or-default "LLM_API_KEY" "")
       (ai-research:option $row "ledger" (str:concat $root "/.cetta/research-calls.jsonl"))
       (ai-research:option $row "call_cap" 0) ()) AiLLM:Disabled))
(= (ai-research:run $row)
   (let* (($options (ai-research:options (ai-research:option $row "options" (JsonObject ()))))
          ($root (fs:canonical-path (str:concat (system:entry-directory) "/.."))))
     (if (and (ai-research:selectors-valid $row) (ai-research:valid $row $options))
       (let* (($goals (case (ai-research:option $row "goals" (JsonArray ()))
                       (((JsonArray $names) $names) ($other InvalidGoals))))
              ($mode (str:string->symbol (ai-research:option $row "mode" "prop"))))
         (if (or (not (== $goals ())) (ai-research:option $row "full_discovery" false))
           (ai-research:prepare $row $options $root $mode $goals)
           (AiResearch:Request explicit-goals-or-full-discovery))) (AiResearch:Request configuration))))
(= (ai-research:prepare $row $options $root $mode $names)
   (let* (($corpus (json:get $row "corpus"))
          ($declarations (ai-math:load-library $corpus))
          ($lean (ai-research:option $row "lean" (system:getenv-or-default "LEAN_BIN" "lean")))
          ($vampire (ai-research:option $row "vampire" (system:getenv-or-default "VAMPIRE_BIN" "vampire")))
          ($context (ai-math:research-profile (ai-math:prover-with $declarations $corpus $root $lean $vampire
            ((slices (ai-math:option $options slices (16 32 64 128 256 512)))
             (vampire-seconds (ai-math:option $options seconds 30))
             (definition-depth (ai-math:option $options definition-depth 3))
             (induction false) (use-duper (ai-math:option $options use-duper Auto)))) $options)))
     (case $context
       (((AiProver $search $thf $itp $vamp $policy)
         (let* (($targets (if (== $names ()) (ai-math:itp-theorems $itp) $names))
                ($valid (and (== (size-atom $targets) (size-atom (unique-atom $targets)))
                  (foldl-atom $targets true $ok $name (and $ok
                    (case (ai-math:get (index-atom $itp 1) $name AiMissing)
                      (((AiITP:Declaration $i THM) true) ($other false)))))))
                ($client (ai-research:client $row $root $mode)))
           (if $valid (ai-research:execute $row $context $declarations $targets $mode $options $client $lean $vampire)
             (AiResearch:Request invalid-goals))))
        ($other $other)))))
(= (ai-research:execute $row $context $declarations $targets $mode $options $client $lean $vampire)
   (let* (($output (json:get $row "output"))
          ($resume (if (ai-research:option $row "resume" false) Resume Fresh))
          ($toolchain (AiResearch:Tools $lean $vampire (system:getenv-or-default "CETTA_BUILD_ID" "unspecified")
            (ai-research:option $row "model" "") (ai-research:option $row "call_cap" 0)
            (str:sha256 (ai-research:option $row "endpoint" "")))))
     (if (ai-math:contains (oracle embedding witness proof-profile oracle-premises recall) $mode)
       (ai-research:observe $row $context $declarations $targets $mode $options $client $toolchain $resume)
       (let $owner (ai-math:research-open $context (json:get $row "corpus") $output $mode $options $toolchain $resume)
         (case $owner
           (((AiRun $c $p $k $s $i) (ai-math:research-run $owner $declarations $targets $mode $options $client))
            ($other $other)))))))
(= (ai-research:embedding-index $row $context $declarations $client)
   (let* (($root (index-atom (index-atom $context 3) 2))
          ($profile (EmbeddingProfile "ai-math.python-embedding.v1" (ai-math:llm-config $client Model)
            "OpenAIEmbeddingsV1" (ai-research:option $row "dimension" 1024) "python-lean-statement-v1"
            (ai-math:llm-config $client Endpoint)))
          ($rows (ai-math:embedding-python-rows $declarations
            (ai-math:embedding-lean-texts (str:concat $root "/lib/MegLib.lean"))))
          ($file (ai-research:option $row "vectors_file" "")))
     (if (not (== $file ""))
       (case (json:parse-at (fs:read-text $file) ("names"))
         (((JsonArray $names)
           (let $selected (map-atom $names $name
                  (case (filter-atom $rows $r (== (index-atom $r 3) $name))
                    ((($r) $r) ($other InvalidEmbeddingName))))
             (ai-math:embedding-python-from-matrix $profile $selected
               (tensor:from-json f64 ((size-atom $names) (index-atom $profile 4)) (fs:read-text $file) ("vectors")))))
          ($other (AiEmbeddingFault vector-file-schema))))
       (let* (($path (ai-research:option $row "cache_file" ""))
              ($cache (if (and (not (== $path "")) (fs:exists $path))
                        (ai-math:embedding-cache-load $profile $path) (embedding:cache-new)))
              ($index (ai-math:embedding-python-prepare $client $profile $rows $cache 64)))
         (case $index
           (((AiPythonEmbedding $kind $p $vectors)
             (let $saved (if (== $path "") () (ai-math:embedding-cache-save $cache $profile
                    (map-atom $rows $r (index-atom $r 4)) $path))
              (if (== $saved ()) (AiPythonEmbedding $kind $p $vectors) (AiEmbeddingFault cache-publication))))
            ($other $other)))))))
(= (ai-research:embedding-fingerprint (AiPythonEmbedding $kind $profile $rows))
   (str:sha256 (str:join "|" (cons-atom (json:stringify (ai-math:embedding-profile-json $profile))
     (map-atom $rows $row (str:join ":" ((str:number->string (index-atom $row 1)) (index-atom $row 3)
       (str:sha256 (index-atom $row 4)) (str:sha256 (tensor:encode (index-atom $row 5))))))))))
(= (ai-research:observe $row $context $declarations $targets $mode $options $client $toolchain $resume)
   (let* (($index (if (== $mode embedding) (ai-research:embedding-index $row $context $declarations $client) None))
          ($ready (if (== $mode embedding)
            (case $index (((AiPythonEmbedding $kind $p $rows) true) ($other false))) true)))
     (if $ready
       (let* (($fingerprint (if (== $mode embedding) (ai-research:embedding-fingerprint $index) "oracle-source-proofs"))
              ($identity (ai-math:research-identity $context (json:get $row "corpus") $mode $options ($toolchain $fingerprint))))
         (ai-math:research-observations $context $declarations $targets $mode $options $index $identity
           (json:get $row "output") $resume)) (AiResearch:Fault $index))))
(= (ai-research:exit-code $result)
   (case $result
     (((AiRun:Summary $key $count $counts $issues)
       (if (> (index-atom (index-atom $counts 3) 1) 0) 2
         (if (> (index-atom (index-atom $counts 2) 1) 0) 3 0)))
      ((AiResearch:Observations $mode $rows)
       (if (foldl-atom $rows true $ok $row
             (and $ok (case $row (((AiResearch:Observed $name $kind) true) ($other false))))) 0 2))
      ($other 2))))
!(let $answers (collapse (if (== (system:argc) 1)
     (let $arg (system:arg 0)
       (ai-research:run (json:parse (fs:read-text (if (== (get-metatype $arg) Symbol) (str:symbol->string $arg) $arg)))))
     (AiResearch:Request configuration-file)))
   (case $answers
     ((($answer) (let $shown (println! $answer) (system:exit (ai-research:exit-code $answer))))
      ($other (let $shown (println! (AiResearch:Fault no-single-result)) (system:exit 2))))))
