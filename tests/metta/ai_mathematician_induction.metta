!(import! &self proc)
!(import! &self "../../phase1/library.metta")
!(import! &self (library list))
!(import! &self (library lib_tptp))
!(import! &self re)
!(import! &self "../../phase1/vampire_output.metta")
!(import! &self "../../phase1/search.metta")
!(import! &self "../../phase1/atp.metta")
!(import! &self json)
!(import! &self system)
!(import! &self "../../phase1/itp.metta")
!(import! &self "../../phase1/proof_strategy.metta")
!(import! &self "../../phase1/induction.metta")
!(import! &self "../../phase1/induction_prover.metta")
!(import! &self "../../phase1/prover.metta")

!(test (ai-math:ind-db
   (index-atom (ai-math:ind-named (ALL (SET) (ALL (SET) (AP (DB 1) (DB 0)))) Goal AiInd:Root ()) 1) ())
   (AiInd:Syntax (ALL (SET) (ALL (SET) (AP (DB 1) (DB 0))))))
!(test (ai-math:ind-named (DB 0) Goal AiInd:Root ()) (AiInd:Request free-variable (DB 0)))
!(test (ai-math:ind-db (VAR absent) ()) (AiInd:Request free-variable (VAR absent)))
!(test (ai-math:ind-substitute (LAM (SET) (VAR x) x) x (VAR y)) (LAM (SET) (VAR x) x))
!(test (ai-math:ind-instantiate (AP (VAR p) (VAR x)) p (LAM (SET) (IMP (VAR t) (VAR t)) t))
   (IMP (VAR x) (VAR x)))
!(test (ai-math:ind-instantiate (AP (LAM (SET) (VAR t) t) (VAR x)) p (VAR y))
   (AP (LAM (SET) (VAR t) t) (VAR x)))
!(test (ai-math:ind-case-candidates () () 0) ())
!(test (map-atom (ai-math:ind-case-candidates (() ()) () 0) $row (index-atom $row 1)) (0 0 0 1 1 1))
!(test (ai-math:ind-case-winners () 0 1) (AiInd:MissingCase 0))
; Closed cases are not acceptance of the whole theorem.
!(test (ai-math:prover-winner
   ((AiProver:Attempt induction-case 0 "case" "assumption" (AiITP:CaseAccepted "goal" 0 1 () ()))))
   AiProver:NoWinner)
!(test (ai-math:ind-case-winner
   ((AiInd:Attempt 0 "wrong-shape" "assumption" (AiITP:CaseAccepted "goal" 0 2 () ()))) 0 1)
   AiInd:NoWinner)
!(test (ai-math:prover-options-valid ((induction true) (induction-slices (8 16))
   (induction-seconds 2) (use-duper false))) true)
!(test (ai-math:prover-options-valid ((induction perhaps))) false)
!(test (ai-math:prover-options-valid ((induction-slices (8 -1)))) false)
!(test (ai-math:prover-options-valid ((use-duper perhaps))) false)
!(test (ai-math:itp-case-candidates-valid ((AiITP:CaseCandidate 0 "same" "one")
   (AiITP:CaseCandidate 1 "same" "two"))) true)
!(test (ai-math:itp-case-candidates-valid ((AiITP:CaseCandidate -1 "bad" "one"))) false)
!(test (ai-math:itp-case-candidates-valid ((AiITP:CaseCandidate 0 "bad" unquoted))) false)
